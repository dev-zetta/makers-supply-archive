diff --git a/packages/ai/test/fileTools.test.ts b/packages/ai/test/fileTools.test.ts
index b42ac5d..461cfc2 100644
--- a/packages/ai/test/fileTools.test.ts
+++ b/packages/ai/test/fileTools.test.ts
@@ -97,4 +97,32 @@ describe("fileTools", () => {
             rs.unstubAllGlobals();
         }
     });
+    test("export_nodes returns exact binary bytes without starting a browser download", async () => {
+        const node = visualNode("n1", "box");
+        const doc = createMockDocument();
+        (doc.modelManager as any).findNodes = rs.fn(() => [node]);
+        const app = createMockApplication();
+        (app as any).activeView = { document: doc };
+        const bytes = new Uint8Array([0, 255, 128, 65]);
+        (app as any).dataExchange = {
+            exportFormats: () => [".stl binary"],
+            export: rs.fn(async () => [bytes]),
+        };
+        rs.stubGlobal("app", app);
+        const createObjectURL = rs.spyOn(URL, "createObjectURL");
+        try {
+            const tool = buildFileTools().find((t) => t.name === "export_nodes")!;
+            const result = JSON.parse((await tool.handler({
+                format: ".stl binary", ids: ["n1"], returnData: true,
+            })) as string);
+            expect(result.bytes).toBe(4);
+            expect(result.filename).toBe("box.stl");
+            expect(result.dataBase64).toBe("AP+AQQ==");
+            expect(createObjectURL).not.toHaveBeenCalled();
+        } finally {
+            createObjectURL.mockRestore();
+            rs.unstubAllGlobals();
+        }
+    });
+
 });
