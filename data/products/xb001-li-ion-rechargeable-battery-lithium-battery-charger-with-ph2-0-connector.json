  "description_blocks": [
    {
      "kind": "heading",
      "text": "Introduction"
    },
    {
      "kind": "paragraph",
      "text": "This page includes rechargeable lithium batteries and matching chargers designed for portable devices and DIY builds. With multiple voltage and capacity options, it provides dependable power for applications such as model toys, small robots, lighting setups, and other battery-powered projects. To ensure safe and efficient charging, please choose the correct charger for the selected battery model."
    },
    {
      "kind": "heading",
      "text": "Product Features"
    },
    {
      "kind": "paragraph",
      "text": "Multiple Options Includes two battery models and two charger models for different power needs. Rechargeable Power Designed for repeated use in portable electronic devices and DIY applications. Practical for DIY Builds Suitable for portable electronics, lighting kits, remote projects, and custom builds."
    },
    {
      "kind": "paragraph",
      "text": "Multiple Options Includes two battery models and two charger models for different power needs."
    },
    {
      "kind": "paragraph",
      "text": "Rechargeable Power Designed for repeated use in portable electronic devices and DIY applications."
    },
    {
      "kind": "paragraph",
      "text": "Practical for DIY Builds Suitable for portable electronics, lighting kits, remote projects, and custom builds."
    },
    {
      "kind": "heading",
      "text": "Warning of Lithium Battery"
    },
    {
      "kind": "bullet",
      "text": "This product utilizes a replaceable rechargeable lithium battery."
    },
    {
      "kind": "bullet",
      "text": "Adult supervision is required when children are handling batteries or the charger. Do not operate the product while it is charging."
    },
    {
      "kind": "bullet",
      "text": "Ensure the battery is installed correctly. Improper installation may result in short circuits, overheating, or potential explosion."
    },
    {
      "kind": "bullet",
      "text": "Regularly inspect the charger’s cord, plug, housing, and other components for damage. If any damage is found, discontinue use immediately until the device is fully repaired."
    },
    {
      "kind": "bullet",
      "text": "Choking Hazard: Contains small parts; not suitable for children under 3 years of age."
    },
    {
      "kind": "bullet",
      "text": "Improper disposal of this product may harm the environment - please recycle responsibly."
    },
    {
      "kind": "heading",
      "text": "Charging Precautions"
    },
    {
      "kind": "bullet",
      "text": "Use only the officially supplied charger. The charger is not a toy."
    },
    {
      "kind": "bullet",
      "text": "Use a standard 5V DC power source with at least 2A output. A 5V/2A USB power adapter is recommended for proper charging performance."
    },
    {
      "kind": "bullet",
      "text": "DO NOT use power adapters with output voltage higher than 5V, or adapters that may trigger 9V/12V fast-charging modes, as this may cause device damage, overheating, or fire hazards."
    },
    {
      "kind": "bullet",
      "text": "Charging from some computer USB ports may be slow or may not provide sufficient current for normal charging."
    },
    {
      "kind": "bullet",
      "text": "DO NOT cover the device while charging, and keep it away from high temperature, humidity, or flammable environments. Never charge the device unattended."
    },
    {
      "kind": "bullet",
      "text": "DO NOT charge the battery pack if it is overheating. Allow it to cool down completely before recharging."
    },
    {
      "kind": "bullet",
      "text": "If the battery pack or charger becomes wet, ensure they are thoroughly dry before attempting to charge."
    },
    {
      "kind": "heading",
      "text": "Lithium Battery Safety Precautions"
    },
    {
      "kind": "bullet",
      "text": "DO NOT attempt to use or charge the battery pack if it shows any signs of leakage or corrosion."
    },
    {
      "kind": "bullet",
      "text": "DO NOT disassemble, crush, or mechanically abuse the battery pack."
    },
    {
      "kind": "bullet",
      "text": "DO NOT dispose of the battery pack in fire."
    },
    {
      "kind": "bullet",
      "text": "Exercise extreme caution when handling an overheated battery pack."
    }
  ],
  "description_html": "<div class=\"pct pct_mc\">\n<div class=\"pct_st-tbc\">\n<div class=\"pct_t-p\">\n<h2 style=\"font-size: 26px; margin: 0 0 16px;\">Introduction</h2>\n<p style=\"margin: 0; color: #333;\">This page includes rechargeable lithium batteries and matching chargers designed for portable devices and DIY builds. With multiple voltage and capacity options, it provides dependable power for applications such as model toys, small robots, lighting setups, and other battery-powered projects. To ensure safe and efficient charging, please choose the correct charger for the selected battery model.</p>\n</div>\n</div>\n</div>\n<div class=\"pct pct_mc\">\n<div class=\"pct_st-tbc\">\n<div class=\"pct_t-p\">\n<h2 style=\"font-size: 24px; margin: 0 0 16px;\">Product Features</h2>\n<div style=\"display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 18px;\">\n<div style=\"background: #fafafa; border: 1px solid #e5e5e5; border-radius: 12px; padding: 18px;\"><strong style=\"display: block; margin-bottom: 8px; font-size: 15px;\">Multiple Options</strong> Includes two battery models and two charger models for different power needs.</div>\n<div style=\"background: #fafafa; border: 1px solid #e5e5e5; border-radius: 12px; padding: 18px;\"><strong style=\"display: block; margin-bottom: 8px; font-size: 15px;\">Rechargeable Power</strong> Designed for repeated use in portable electronic devices and DIY applications.</div>\n<div style=\"background: #fafafa; border: 1px solid #e5e5e5; border-radius: 12px; padding: 18px;\"><strong style=\"display: block; margin-bottom: 8px; font-size: 15px;\">Practical for DIY Builds</strong> Suitable for portable electronics, lighting kits, remote projects, and custom builds.</div>\n</div>\n</div>\n</div>\n</div>\n<div class=\"pct pct_mc\">\n<div class=\"pct_tpc-ic\">\n<div class=\"pct_t-p\">\n<h2 class=\"pct_t\" style=\"font-size: 24px; text-align: center;\">Important Notices</h2>\n<h2 style=\"margin-top: 20px; margin-bottom: 0px; font-size: 20px; text-align: left;\">Warning of Lithium Battery</h2>\n<ul>\n<li style=\"text-align: left; font-size: 16px;\">This product utilizes a replaceable rechargeable lithium battery.</li>\n<li style=\"text-align: left; font-size: 16px;\">Adult supervision is required when children are handling batteries or the charger. Do not operate the product while it is charging.</li>\n<li style=\"text-align: left; font-size: 16px;\">Ensure the battery is installed correctly. Improper installation may result in short circuits, overheating, or potential explosion.</li>\n<li style=\"text-align: left; font-size: 16px;\">Regularly inspect the charger’s cord, plug, housing, and other components for damage. If any damage is found, discontinue use immediately until the device is fully repaired.</li>\n<li style=\"text-align: left; font-size: 16px;\">Choking Hazard: Contains small parts; not suitable for children under 3 years of age.</li>\n<li style=\"text-align: left; font-size: 16px;\">Improper disposal of this product may harm the environment - please recycle responsibly.</li>\n</ul>\n<h2 style=\"margin-top: 20px; margin-bottom: 0px; font-size: 20px; text-align: left;\">Charging Precautions</h2>\n<ul>\n<li style=\"text-align: left; font-size: 16px;\">Use only the officially supplied charger. The charger is not a toy.</li>\n<li style=\"text-align: left; font-size: 16px;\">Use a standard 5V DC power source with at least 2A output. A 5V/2A USB power adapter is recommended for proper charging performance.</li>\n<li style=\"text-align: left; font-size: 16px;\"><strong>DO NOT</strong> use power adapters with output voltage higher than 5V, or adapters that may trigger 9V/12V fast-charging modes, as this may cause device damage, overheating, or fire hazards.</li>\n<li style=\"text-align: left; font-size: 16px;\">Charging from some computer USB ports may be slow or may not provide sufficient current for normal charging.</li>\n<li style=\"text-align: left; font-size: 16px;\"><strong>DO NOT</strong> cover the device while charging, and keep it away from high temperature, humidity, or flammable environments. Never charge the device unattended.</li>\n<li style=\"text-align: left; font-size: 16px;\"><strong>DO NOT</strong> charge the battery pack if it is overheating. Allow it to cool down completely before recharging.</li>\n<li style=\"text-align: left; font-size: 16px;\">If the battery pack or charger becomes wet, ensure they are thoroughly dry before attempting to charge.</li>\n</ul>\n<h2 style=\"margin-top: 20px; margin-bottom: 0px; font-size: 20px; text-align: left;\">Lithium Battery Safety Precautions</h2>\n<ul>\n<li style=\"text-align: left; font-size: 16px;\"><strong>DO NOT</strong> attempt to use or charge the battery pack if it shows any signs of leakage or corrosion.</li>\n<li style=\"text-align: left; font-size: 16px;\"><strong>DO NOT</strong> disassemble, crush, or mechanically abuse the battery pack.</li>\n<li style=\"text-align: left; font-size: 16px;\"><strong>DO NOT</strong> dispose of the battery pack in fire.</li>\n<li style=\"text-align: left; font-size: 16px;\">Exercise extreme caution when handling an overheated battery pack.</li>\n</ul>\n</div>\n</div>\n</div>\n<div class=\"pct pct_mc\">\n<div class=\"pct_st-tbc\">\n<div class=\"pct_t-p\">\n<h2 class=\"pct_t\" style=\"font-size: 24px; text-align: center;\">Product Specifications</h2>\n<h2 style=\"margin-top: 20px; margin-bottom: 0px; font-size: 20px; text-align: left;\">Battery Charger with PH2.0 Connector</h2>\n<table class=\"pct_tb\" style=\"border-color: #adadad; font-weight: bold; height: 55px; width: 100%;\">\n<thead class=\"pct_th\">\n<tr style=\"height: 40px;\">\n<td class=\"pct_td\" style=\"background-color: #c7c7c7; color: #333333; border-color: #adadad; font-weight: bold; text-align: center; height: 40px; width: 13.6939%; padding: 10px !important;\">\n<div>Product ID</div>\n</td>\n<td class=\"pct_td\" style=\"background-color: #c7c7c7; color: #333333; border-co