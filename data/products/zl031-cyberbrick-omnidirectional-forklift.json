  "description_blocks": [
    {
      "kind": "heading",
      "text": "Omnidirectional Movement"
    },
    {
      "kind": "paragraph",
      "text": "Move freely in any direction without changing the vehicle’s heading, making the model feel more flexible and responsive."
    },
    {
      "kind": "heading",
      "text": "Advanced Maneuverability"
    },
    {
      "kind": "paragraph",
      "text": "Control the vehicle with tank-style differential steering for smooth, low-speed maneuvering, enhanced by offset pivot movement that lets you rotate around custom points rather than just spinning in place."
    },
    {
      "kind": "heading",
      "text": "Forklift Lift Control"
    },
    {
      "kind": "paragraph",
      "text": "Raise and lower the fork with precise control, adding more interactive play value and making the model feel like a real working vehicle."
    },
    {
      "kind": "heading",
      "text": "Remote Control Instruction"
    },
    {
      "kind": "paragraph",
      "text": "This model is designed to work with the CyberBrick Remote. The pre-configured settings have been uploaded for immediate play,"
    },
    {
      "kind": "paragraph",
      "text": "while the CyberBrick App allows full customization of controller functions to match your personal preferences."
    },
    {
      "kind": "paragraph",
      "text": "* Please visit the CyberBrick Official Standard Remote on Makerworld for more details."
    },
    {
      "kind": "heading",
      "text": "CyberBrick App Connection Tutorial"
    },
    {
      "kind": "paragraph",
      "text": "*The following is the App connection of CyberBrick Official SoccerBot as an example, which is similar to this model."
    },
    {
      "kind": "heading",
      "text": "Core Safety Rules"
    },
    {
      "kind": "bullet",
      "text": "This product is intended for users aged 14 and above. Users under the age of 14 must be under direct adult supervision throughout use."
    },
    {
      "kind": "bullet",
      "text": "DO NOT touch the moving parts while the device is operating to prevent pinching injuries."
    },
    {
      "kind": "bullet",
      "text": "Please use only official tools for any firmware operations. Flashing with third-party tools is not supported and may cause irreversible damage, which is not covered by warranty."
    },
    {
      "kind": "bullet",
      "text": "Before use, inspect all 3D-printed parts and sand down any sharp edges or burrs if present. Store the model and small parts in a location out of reach of children and pets to prevent choking hazards."
    },
    {
      "kind": "heading",
      "text": "Warning of Lithium Battery"
    },
    {
      "kind": "bullet",
      "text": "This product utilizes a replaceable rechargeable lithium battery."
    },
    {
      "kind": "bullet",
      "text": "Adult supervision is required when children are handling batteries or the charger. Do not operate the product while it is charging."
    },
    {
      "kind": "bullet",
      "text": "Ensure the battery is installed correctly. Improper installation may result in short circuits, overheating, or potential explosion."
    },
    {
      "kind": "bullet",
      "text": "Regularly inspect the charger’s cord, plug, housing, and other components for damage. If any damage is found, discontinue use immediately until the device is fully repaired."
    },
    {
      "kind": "bullet",
      "text": "Choking Hazard: Contains small parts; not suitable for children under 3 years of age."
    },
    {
      "kind": "bullet",
      "text": "Improper disposal of this product may harm the environment - please recycle responsibly."
    },
    {
      "kind": "heading",
      "text": "Charging Precautions"
    },
    {
      "kind": "bullet",
      "text": "Use only the officially supplied charger. The charger is not a toy."
    },
    {
      "kind": "bullet",
      "text": "The USB charger for this product only supports standard 5V 1-2A input. Please always use the original charger that meets the voltage/current requirements, or charge directly via a computer USB port. DO NOT use chargers with output higher than 5V or 2A (such as mobile fast chargers, 9V/12V adapters, etc.), as this may cause device damage, overheating, or even serious fire hazards."
    },
    {
      "kind": "bullet",
      "text": "DO NOT cover the device while charging, and keep it away from high temperature, humidity, or flammable environments. Never charge the device unattended."
    },
    {
      "kind": "bullet",
      "text": "DO NOT charge the battery pack if it is overheating. Allow it to cool down completely before recharging."
    },
    {
      "kind": "bullet",
      "text": "If the battery pack or charger becomes wet, ensure they are thoroughly dry before attempting to charge."
    },
    {
      "kind": "heading",
      "text": "Lithium Battery Safety Precautions"
    },
    {
      "kind": "bullet",
      "text": "DO NOT attempt to use or charge the battery pack if it shows any signs of leakage or corrosion."
    },
    {
      "kind": "bullet",
      "text": "DO NOT disassemble, crush, or mechanically abuse the battery pack."
    },
    {
      "kind": "bullet",
      "text": "DO NOT dispose of the battery pack in fire."
    },
    {
      "kind": "bullet",
      "text": "Exercise extreme caution when handling an overheated battery pack."
    }
  ],
  "description_html": "<div class=\"pct pct_mc\">\n<div class=\"pct_t-stpcic\">\n<div class=\"pct_stpc-ic\">\n<div class=\"pct_st-p\">\n<h3 class=\"pct_st\">Omnidirectional Movement</h3>\n<div data-docx-has-block-data=\"false\" data-page-id=\"module-content\">\n<p class=\"pct_p\" style=\"text-align: left;\">Move freely in any direction without changing the vehicle’s heading, making the model feel more flexible and responsive.</p>\n</div>\n</div>\n<!-- 右侧图片部分 -->\n<div class=\"pct_ic\"><video autoplay=\"autoplay\" class=\"product-desc-lazy-media product-desc-lazy-media--video bg-bbl-white animate-pulse aspect-video max-h-[400px]\" controls=\"controls\" data-lazy=\"false\" data-mce-src=\"https://store.bblcdn.com/s1/default/5e2cea66357a4e7580d752d2f7b28654/Omnidirectional_Movement.mp4\" data-mce-style=\"width: 100%;\" data-src=\"https://store.bblcdn.com/s1/default/5e2cea66357a4e7580d752d2f7b28654/Omnidirectional_Movement.mp4\" height=\"150\" loop=\"loop\" muted=\"\" playsinline=\"\" poster=\"https://store.bblcdn.com/s1/default/5e2cea66357a4e7580d752d2f7b28654/Omnidirectional_Movement.mp4\" style=\"width: 100%;\" width=\"300\"></video></div>\n</div>\n<div class=\"pct_stpc-ic\"><!-- 第2卖点 -->\n<div class=\"pct_st-p\">\n<h3 class=\"pct_st\" style=\"text-align: left;\">Advanced Maneuverability</h3>\n<p class=\"pct_p\" style=\"text-align: left;\">Control the vehicle with tank-style differential steering for smooth, low-speed maneuvering, enhanced by offset pivot movement that lets you rotate around custom points rather than just spinning in place.</p>\n</div>\n<div class=\"pct_ic\"><video autoplay=\"autoplay\" class=\"product-desc-lazy-media product-desc-lazy-media--video bg-bbl-white animate-pulse aspect-video max-h-[400px]\" controls=\"controls\" data-lazy=\"false\" data-mce-src=\"https://store.bblcdn.com/s1/default/56ef9e1844b74df49c4e991ab80d349a/2.mp4\" data-mce-style=\"width: 100%;\" data-src=\"https://store.bblcdn.com/s1/default/56ef9e1844b74df49c4e991ab80d349a/2.mp4\" height=\"150\" loop=\"loop\" muted=\"\" playsinline=\"\" poster=\"https://store.bblcdn.com/s1/default/56ef9e1844b74df49c4e991ab80d349a/2.mp4\" style=\"width: 100%;\" width=\"300\"></video></div>\n</div>\n</div>\n</div>\n<div class=\"pct pct_mc\">\n<div class=\"pct_t-stpcic\">\n<div class=\"pct_stpc-ic\">\n<div class=\"pct_st-p\">\n<h3 class=\"pct_st\">Forklift Lift Control</h3>\n<div data-docx-has-block-data=\"false\" data-page-id=\"module-content\">\n<p class=\"pct_p\" style=\"text-align: left;\">Raise and lower the fork with precise control, adding more interactive play value and making the model feel like a real working vehicle.</p>\n</div>\n</div>\n<!-- 右侧图片部分 -->\n<div class=\"pct_ic\"><video autoplay=\"autoplay\" class=\"product-desc-lazy-media product-desc-lazy-media--video bg-bbl-white animate-pulse aspect-video max-h-[400px]\" controls=\"controls\" data-lazy=\"false\" data-mce-src=\"https://store.bblcdn.com/s1/default/743a9163ac0a4af9a7c5c85c4e717644/Forklift_Lift_Control.mp4\" data-mce-style=\"width: 100%;\" data-src=\"https://store.bblcdn.com/s1/default/743a9163ac0a4af9a7c5c85c4e717644/Forklift_Lift_Control.mp4\" height=\"150\" loop=\"loop\" muted=\"\" playsinline=\"\" poster=\"https://store.bblcdn.com/s1/default/743a9163ac0a4af9a7c5c85c4e717644/Forklift_Lift_Control.mp4\" style=\"width: 100%;\" width=\"300\"></video></div>\n</div>\n</div>\n</div>\n<div class=\"pct pct_mc\">\n<div class=\"pct_ic\">\n<div class=\"pct pct_mc\">\n<div class=\"pct_tpc-ic\">\n<div class=\"pct_t-p\">\n<p></p>\n<h2 class=\"pct_t\" style=\"margin-top: 20px; font-size: 24px;\">Remote Control Instruction</h2>\n<p class=\"pct_p\" style=\"text-align: center;\">This model is designed to work with the CyberBrick Remote. The pre-configured settings have been uploaded for immediate play,</p>\n<p>while the CyberBrick App allows full customization of controller functions to match your personal preferences.</p>\n<p class=\"pct_p\" style=\"text-align: center;\"><em><span style=\"font-size: 12px;\">* Please visit the <a href=\"https://makerworld.com/en/models/1395991-cyberbrick-official-standard-remote#profileId-1446992\" rel=\"noopener\" target=\"_blank\"><strong><span style=\"color: #00ae42;\">CyberBrick Official Standard Remote on Makerworld </span></strong></a> for more details.</span></em></p>\n</div>\n</div>\n<style>\n        .image-container {\n            display: flex;\n            gap: 30px; \n            justify-content: center; \n            align-items: center; \n            height: auto; \n        }\n        .image-container img {\n            width: 650px;\n            height: flex;\n            object-fit: contain; \n        }\n    </style>\n<div class=\"image-container\"><img class=\"product-desc-lazy-media product-desc-lazy-media--image bg-bbl-white animate-pulse aspect-video max-h-[400px]\" data-lazy=\"false\" data-src=\"https://store.bblcdn.com/s1/default/0294d221c50a4875bee164318090e6a8/controller.png\" height=\"525\" src=\"data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjQiIGhlaWdodD0iMjQiIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj4KPHJlY3Qgd2lkdGg9IjI0IiBoZWlnaHQ9IjI0IiBmaWxsPSIjRkZGRkZGIi8+Cjwvc3ZnPgo=\" width=\"735\"/> <a href=\"https://bambulab.com/en/download/cyberbrick-apps\" rel=\"noopener\" target=\"_blank\"><img class=\"product-desc-lazy-media product-desc-lazy-media--image bg-bbl-white animate-pulse aspect-video max-h-[400px]\" data-lazy=\"false\" data-src=\"https://store.bblcdn.com/s1/default/c822010a332c4bf6b9c6ec5db116a293/Frame_1123867487.jpg\" height=\"527\" src=\"data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjQiIGhlaWdodD0iMjQiIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj4KPHJlY3Qgd2lkdGg9IjI0IiBoZWlnaHQ9IjI0IiBmaWxsPSIjRkZGRkZGIi8+Cjwvc3ZnPgo=\" width=\"735\"/></a></div>\n</div>\n</div>\n</div>\n<div class=\"pct pct_mc\">\n<div class=\"pct_tpc-ic\">\n<div class=\"pct_t-p\">\n<h2 class=\"pct_t\" style=\"margin-top: 20px; margin-bottom: 10px; font-size: 24px; text-align: center;\">CyberBrick App Connection Tutorial</h2>\n<p style=\"text-align: left; margin-top: 10px; margin-bottom: -40px;\"><span style=\"font-size: 14px;\"><em>*The following is the App connection of CyberBrick Official SoccerBot as an example, which is similar to this model.</em></span></p>\n</div>\n</div>\n</div>\n<div class=\"pct pct_mc\">\n<div class=\"pct_tpc-ic\">\n<div class=\"pct_t-p\">\n<h2 class=\"pct_t\" style=\"margin-top: 20px; font-size: 24px; text-align: center;\">In The Box</h2>\n</div>\n</div>\n</div>\n<div class=\"pct pct_mc\">\n<div class=\"pct_st-tbc\">\n<div class=\"pct_tbc\">\n<table class=\"pct_tb\" style=\"width: 100%; text-align: center; border-collapse: collapse; height: 103px;\">\n<thead class=\"pct_th\">\n<tr style=\"background-color: #333333; color: white;\">\n<td class=\"pct_td\" style=\"border: 1px solid #333333; padding: 10px; height: 26px;\"><strong>Item Name</strong></td>\n<td class=\"pct_td\" style=\"border: 1px solid #333333; padding: 10px; width: 20%; height: 26px;\"><strong>ZL031</strong></td>\n<td class=\"pct_td\" style=\"border: 1px solid #333333; padding: 10px; width: 20%; height: 26px;\"><strong>ZL031-1</strong></td>\n</tr>\n</thead>\n<tbody>\n<tr class=\"pct_tr\" style=\"height: 19px;\">\n<td class=\"pct_td\" style=\"border: 1px solid #cccccc; padding: 10px; height: 50px;\">\n<div class=\"hover-img-container\">\n<p style=\"margin: 0;\"><span style=\"color: #00ae42;\"><strong><a href=\"../../products/cyberbrick-hardware-kit?id=593290263704776711\" rel=\"noopener\" style=\"color: #00ae57;\" target=\"_blank\">CyberBrick Beginner Hardware Kit - ZK004</a></strong></span></p>\n<img class=\"hover-img product-desc-lazy-media product-desc-lazy-media--image bg-bbl-white animate-pulse max-h-[400px]\" data-lazy=\"false\" data-src=\"https://store.bblcdn.com/s7/default/87d9af310b92481e92c2d6b817c3d6f2/B-ZK004.png\" src=\"data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjQiIGhlaWdodD0iMjQiIHZpZXdCb3g9IjAgM