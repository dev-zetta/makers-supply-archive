  "description_blocks": [
    {
      "kind": "heading",
      "text": "Product Feature"
    },
    {
      "kind": "paragraph",
      "text": "Magnetic design with replaceable batteries ( 1 battery and 1 magnet ( D8x2 mm Round Magnet ) included ) | Energy Efficient"
    },
    {
      "kind": "paragraph",
      "text": "Easy Operation | Adjustable lighting modes for different needs"
    },
    {
      "kind": "heading",
      "text": "Considerations"
    },
    {
      "kind": "bullet",
      "text": "This product is intended for ages 14 and up and is not suitable for use in any children's products, toys, or household items intended for children."
    },
    {
      "kind": "bullet",
      "text": "This product contains small parts and poses a choking hazard. Do not ingest. If accidentally swallowed, seek immediate medical attention. Keep out of reach of children."
    },
    {
      "kind": "bullet",
      "text": "Please be aware that the device is programmed to automatically enter sleep mode after 10 minutes of operation."
    }
  ],
