td>\n<td class=\"pct_td\" style=\"text-align: center; height: 50px; width: 83.425px;\">1</td>\n</tr>\n<tr class=\"pct_tr\" style=\"height: 50px;\">\n<td class=\"pct_td\" style=\"text-align: center; height: 50px; width: 102.637px;\">M5</td>\n<td class=\"pct_td\" style=\"text-align: center; height: 50px; width: 125.35px;\">7</td>\n<td class=\"pct_td\" style=\"text-align: center; height: 50px; width: 241.488px;\">17.5</td>\n<td class=\"pct_td\" style=\"text-align: center; height: 50px; width: 83.425px;\">1</td>\n</tr>\n<tr class=\"pct_tr\" style=\"height: 50px;\">\n<td class=\"pct_td\" style=\"text-align: center; height: 50px; width: 102.637px;\">M6</td>\n<td class=\"pct_td\" style=\"text-align: center; height: 50px; width: 125.35px;\">7</td>\n<td class=\"pct_td\" style=\"text-align: center; height: 50px; width: 241.488px;\">12.5</td>\n<td class=\"pct_td\" style=\"text-align: center; height: 50px; width: 83.425px;\">1</td>\n</tr>\n<tr class=\"pct_tr\" style=\"height: 50px;\">\n<td class=\"pct_td\" style=\"text-align: center; height: 50px; width: 102.637px;\">M8</td>\n<td class=\"pct_td\" style=\"text-align: center; height: 50px; width: 125.35px;\">9</td>\n<td class=\"pct_td\" style=\"text-align: center; height: 50px; width: 241.488px;\">12.5</td>\n<td class=\"pct_td\" style=\"text-align: center; height: 50px; width: 83.425px;\">1</td>\n</tr>\n<tr class=\"pct_tr\" style=\"height: 50px;\">\n<td class=\"pct_td\" style=\"text-align: center; height: 50px; width: 102.637px;\">Handle</td>\n<td class=\"pct_td\" style=\"text-align: center; height: 50px; width: 125.35px;\">6.5</td>\n<td class=\"pct_td\" style=\"text-align: center; height: 50px; width: 241.488px;\">34</td>\n<td class=\"pct_td\" style=\"text-align: center; height: 50px; width: 83.425px;\">1</td>\n</tr>\n</tbody>\n</table>\n</div>\n</div>\n</div>\n</div>\n</div>",
