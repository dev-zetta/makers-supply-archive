  "description_html": "<div class=\"pct pct_mc\">\n<h2 class=\"pct_st\"></h2>\n<p> </p>\n<h2 class=\"pct_t\">Documentation</h2>\n<h2 class=\"pct_st\"></h2>\n<p class=\"pct_padding-in-mobile pct_downloadContent\" style=\"text-align: center; gap: 40px; display: flex; justify-content: center;\"><a href=\"https://store.bblcdn.com/s7/default/8f8426afeff041a594422b69a00d9a44/Round_Magnets.pdf\" rel=\"noopener\" style=\"color: #333333; font-weight: 600; display: flex; justify-content: center; align-items: center; gap: 20px;\" target=\"_blank\"> <img alt=\"2D\" class=\"download_svg product-desc-lazy-media product-desc-lazy-media--image bg-bbl-white animate-pulse max-h-[400px]\" data-lazy=\"false\" data-src=\"https://store.bblcdn.com/s7/default/1ed6b71b4c814ac3bc34933673003555/2d.svg\" src=\"data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjQiIGhlaWdodD0iMjQiIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj4KPHJlY3Qgd2lkdGg9IjI0IiBoZWlnaHQ9IjI0IiBmaWxsPSIjRkZGRkZGIi8+Cjwvc3ZnPgo=\"/> Specification </a> <a href=\"https://store.bblcdn.com/s7/default/eded5e39f9cb4b9788b061899e909b62/Round_Magnet.zip\" rel=\"noopener\" style=\"color: #333333; font-weight: 600; display: flex; justify-content: center; align-items: center; gap: 20px;\" target=\"_blank\"> <img alt=\"3D\" class=\"download_svg product-desc-lazy-media product-desc-lazy-media--image bg-bbl-white animate-pulse max-h-[400px]\" data-lazy=\"false\" data-src=\"https://store.bblcdn.com/s7/default/34cfd495f6e74bb59595d83a7b486516/3d.svg\" src=\"data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjQiIGhlaWdodD0iMjQiIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj4KPHJlY3Qgd2lkdGg9IjI0IiBoZWlnaHQ9IjI0IiBmaWxsPSIjRkZGRkZGIi8+Cjwvc3ZnPgo=\"/> 3D Model </a></p>\n</div>\n<div class=\"pct pct_mc\"><!-- 第一条 -->\n<div class=\"pct_st-p\">\n<p class=\"pct_p\"></p>\n<h3 class=\"pct_st\"><strong>Overview<strong></strong></strong></h3>\nIf you plan to use Make My Sign in Maker Lab, consider these two magnets. They fit precisely into the holes in Make My Sign and can securely attach your creations to any magnetic surface. Visit <a href=\"https://makerworld.com/en/makerlab/makeMySign/edit/1177242?from=bambustore\" rel=\"noopener\" target=\"_blank\"><span style=\"color: #00ae42;\"><strong>Maker Lab Make My Sign</strong></span></a> to start your creation!<!-- 图片 --></div>\n<div class=\"pct_st-p\">\n<p> </p>\n<!-- 图片 -->\n<div class=\"pct pct_mc\">\n<div class=\"pct_tpc-ic\">\n<div class=\"pct_ic\"><!-- 手机端图片 --> <img alt=\"Socket Head Cap Machine Screws (SHCS)\" class=\"pct_mi product-desc-lazy-media product-desc-lazy-media--image bg-bbl-white animate-pulse max-h-[400px]\" data-lazy=\"false\" data-src=\"https://store.bblcdn.com/s7/default/a6e81c483a874bb88133fe59136b45b0/Round_Magnets.png\" src=\"data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjQiIGhlaWdodD0iMjQiIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj4KPHJlY3Qgd2lkdGg9IjI0IiBoZWlnaHQ9IjI0IiBmaWxsPSIjRkZGRkZGIi8+Cjwvc3ZnPgo=\"/> <!-- PC端图片 --> <img alt=\"Socket Head Cap Machine Screws (SHCS)\" class=\"pct_i product-desc-lazy-media product-desc-lazy-media--image bg-bbl-white animate-pulse max-h-[400px]\" data-lazy=\"false\" data-src=\"https://store.bblcdn.com/s7/default/a6e81c483a874bb88133fe59136b45b0/Round_Magnets.png\" src=\"data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjQiIGhlaWdodD0iMjQiIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj4KPHJlY3Qgd2lkdGg9IjI0IiBoZWlnaHQ9IjI0IiBmaWxsPSIjRkZGRkZGIi8+Cjwvc3ZnPgo=\"/></div>\n</div>\n</div>\n<!-- 图片结束 -->\n<p> </p>\n<!-- table布局 -->\n<div class=\"pct pct_mc\">\n<div class=\"pct_st-tbc\">\n<h2 class=\"pct_t\"></h2>\n<div class=\"pct_tbc\">\n<table class=\"pct_tb\" style=\"border-color: #ADADAD; font-weight: bold;\"><!-- 表头 -->\n<thead class=\"pct_th\">\n<tr>\n<td class=\"pct_td\" style=\"padding: 10px!important; background-color: #c7c7c7; color: #333333; border-color: #ADADAD; font-weight: bold; text-align: center;\">\n<div>Product ID</div>\n</td>\n<td class=\"pct_td\" style=\"padding: 10px!important; background-color: #c7c7c7; color: #333333; border-color: #ADADAD; font-weight: bold;\">\n<div>D (mm)</div>\n<p>Diameter</p>\n</td>\n<td class=\"pct_td\" style=\"padding: 10px!important; background-color: #c7c7c7; color: #333333; border-color: #ADADAD; font-weight: bold;\">\n<div>H (mm)\n<p>Thickness</p>\n</div>\n</td>\n<td class=\"pct_td\" style=\"padding: 10px!important; background-color: #c7c7c7; color: #333333; border-color: #ADADAD; font-weight: bold;\">\n<div>Magnet Grade</div>\n</td>\n</tr>\n</thead>\n<tbody>\n<tr class=\"pct_tr\">\n<td class=\"pct_td\" style=\"padding: 10px!important; border-color: #ADADAD; text-align: center;\">CA004</td>\n<td class=\"pct_td\" style=\"padding: 10px!important; border-color: #ADADAD;\">6</td>\n<td class=\"pct_td\" style=\"padding: 10px!important; border-color: #ADADAD;\">2</td>\n<td class=\"pct_td\" style=\"padding: 10px!important; border-color: #ADADAD;\">N35</td>\n</tr>\n<tr class=\"pct_tr\">\n<td class=\"pct_td\" style=\"padding: 10px!important; border-color: #ADADAD; text-align: center;\">CA010</td>\n<td class=\"pct_td\" style=\"padding: 10px!important; border-color: #ADADAD;\">12</td>\n<td class=\"pct_td\" style=\"padding: 10px!important; border-color: #ADADAD;\">3</td>\n<td class=\"pct_td\" style=\"padding: 10px!important; border-color: #ADADAD;\">N35</td>\n</tr>\n</tbody>\n</table>\n</div>\n</div>\n</div>\n<!-- table布局 -->\n<p> </p>\n<!-- 物品清单布局 --></div>\n</div>\n<div class=\"pct pct_mc\">\n<div class=\"pct_st-p\">\n<div class=\"pct pct_mc\">\n<div class=\"pct_st-p\">\n<div class=\"pct pct_mc\">\n<div class=\"pct_t-icpc pct_padding-in-mobile .pct_hardware-tableList pct_hardware-tableList-t-icpc\">\n<h2 class=\"pct_t\"></h2>\n<h2 class=\"pct_st\"></h2>\n<h2 class=\"pct_t\">Basic Information</h2>\n<div class=\"pct_icpc pct_grad-2-pc pct_grad-1-mobile pct_hardware-tableList\"><!-- 第一条 -->\n<div class=\"pct_ic-p\"><!-- table布局 -->\n<div class=\"pct pct_mc\">\n<div class=\"pct_st-tbc\" style=\"padding: 0;\">\n<div class=\"pct_tbc\">\n<table class=\"pct_tb\" style=\"width: 100%; margin-top: 0; font-weight: bold;\"><!-- 表头 -->\n<tbody>\n<tr class=\"pct_tr\">\n<td class=\"pct_td\" style=\"background-color: #c7c7c7; width: 45%; text-align: center;\">Surface Treatment</td>\n<td class=\"pct_td\">Nickel plating</td>\n</tr>\n<tr class=\"pct_tr\">\n<td class=\"pct_td\" style=\"background-color: #c7c7c7; width: 45%; text-align: center;\">Mount Type</td>\n<td class=\"pct_td\">Magnetic</td>\n</tr>\n<tr class=\"pct_tr\">\n<td class=\"pct_td\" style=\"background-color: #c7c7c7; width: 45%; text-align: center;\">Shape</td>\n<td class=\"pct_td\">Disc</td>\n</tr>\n<tr class=\"pct_tr\">\n<td class=\"pct_td\" style=\"background-color: #c7c7c7; width: 45%; text-align: center;\">Package Size</td>\n<td class=\"pct_td\">60x40x20 (mm)</td>\n</tr>\n</tbody>\n</table>\n</div>\n</div>\n</div>\n<!-- table布局 --></div>\n<!-- 第二条 -->\n<div class=\"pct_ic-p\">\n<div class=\"pct_ic\"><!-- table布局 -->\n<div class=\"pct pct_mc\">\n<div class=\"pct_st-tbc\" style=\"padding: 0;\">\n<div class=\"pct_tbc\">\n<table class=\"pct_tb\" style=\"width: 100%; margin-top: 0px; font-weight: bold; height: 76px;\"><!-- 表头 -->\n<tbody>\n<tr class=\"pct_tr\">\n<td class=\"pct_td\" style=\"background-color: #c7c7c7; width: 45%; text-align: center;\">Material</td>\n<td class=\"pct_td\" style=\"height: 19px;\">Neodymium magnet</td>\n</tr>\n<tr class=\"pct_tr\">\n<td class=\"pct_td\" style=\"background-color: #c7c7c7; width: 45%; text-align: center;\">Direction of Magnetization</td>\n<td class=\"pct_td\" style=\"height: 19px;\">Through thickness</td>\n</tr>\n<tr class=\"pct_tr\">\n<td class=\"pct_td\" style=\"background-color: #c7c7c7; width: 45%; text-align: center;\">Max Temperature</td>\n<td class=\"pct_td\" style=\"height: 19px;\">80℃</td>\n</tr>\n<tr class=\"pct_tr\">\n<td class=\"pct_td\" style=\"background-color: #c7c7c7; width: 45%; text-align: center;\">Color</td>\n<td class=\"pct_td\" style=\"height: 19px;\">Silver</td>\n</tr>\n</tbody>\n</table>\n</div>\n</div>\n</div>\n<!-- table布局 --></div>\n</div>\n<!-- 如需添加在此处添加 --></div>\n</div>\n</div>\n<!-- 标题加文案结束 -->\n<p> </p>\n<!-- 查看PDF --></div>\n</div>\n</div>\n</div>\n<div class=\"pct pct_mc\">\n<div class=\"pct_ic\">\n<div class=\"pct_t-p\">\n<h2 class=\"pct_t\" style=\"margin-top: 20px; margin-bottom: 20px; font-size: 24px; text-align: center;\">Considerations</h2>\n<ul>\n<li style=\"text-align: left; font-size: 20px;\"><span style=\"font-size: 16px;\">This product is intended for ages 14 and up and is not suitable for use in any children's products, toys, or household items intended for children.</span></li>\n<li style=\"text-align: left; font-size: 20px;\"><span style=\"font-size: 16px;\">This product contains small parts and poses a choking hazard. Do not ingest. If accidentally swallowed, seek immediate medical attention. Keep out of reach of children.</span></li>\n</ul>\n</div>\n</div>\n</div>",
