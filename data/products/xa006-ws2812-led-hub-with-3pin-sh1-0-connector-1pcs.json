  "description_blocks": [
    {
      "kind": "heading",
      "text": "Introduction"
    },
    {
      "kind": "paragraph",
      "text": "The WS2812 LED Hub is designed to connect WS2812 RGB LEDs to the LED output port of an expansion board. It enables independent control of multiple LEDs through the supported communication protocol. When used with multiple WS2812 LEDs, it delivers a variety of visual effects, making it suitable for models or applications that require multiple LED units."
    }
  ],
