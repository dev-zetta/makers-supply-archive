  "description_blocks": [
    {
      "kind": "heading",
      "text": "Overview"
    },
    {
      "kind": "paragraph",
      "text": "The product contains all the non-3D printed parts for assembling an entirely functional Multi-Use Case. To complete the work, you also need to download the model files and 3D print the remaining parts."
    },
    {
      "kind": "paragraph",
      "text": "To download the model files of the Compact Multi-Use Case and obtain detailed information, please visit the Compact Multi-Use Case on MakerWorld."
    }
  ],
  "description_html": "<div class=\"pct pct_mc\">\n<div class=\"pct_t-stpc\"><!-- 第一条 -->\n<div class=\"pct_st-p\">\n<h3 class=\"pct_st\">Overview</h3>\n<p class=\"pct_p\">The product contains all the <strong data-mce-fragment=\"1\">non-3D printed</strong> parts for assembling an entirely functional <strong data-mce-fragment=\"1\">Multi-Use Case</strong>. To complete the work, you also need to download the <strong data-mce-fragment=\"1\">model files</strong> and <strong data-mce-fragment=\"1\">3D print</strong> the remaining parts.<span data-mce-fragment=\"1\"></span></p>\n</div>\n<div class=\"pct pct_mc\">\n<div class=\"pct_t-tb\">\n<table class=\"pct_tb\"><!-- 表头 --></table>\n<div data-docx-has-block-data=\"false\" data-page-id=\"OKsfdVZTpoQRnExo2lIcyoskncC\">\n<div class=\"ace-line ace-line old-record-id-K4OCdHYOOop5aGxqeiFcWXYnnXe\"><span data-mce-fragment=\"1\">To download the model files of the <strong data-mce-fragment=\"1\">Compact Multi-Use Case</strong></span><span data-mce-fragment=\"1\"> and obtain detailed information, please visit the </span><strong data-mce-fragment=\"1\">Compact Multi-Use Case </strong><span data-mce-fragment=\"1\">on </span><a href=\"https://makerworld.com/en/models/474983?from=search#profileId-385650\" rel=\"noopener\" target=\"_blank\"><span data-mce-fragment=\"1\" style=\"color: #00ae42;\"><strong data-mce-fragment=\"1\"><u data-mce-fragment=\"1\">MakerWorld</u></strong></span></a><span data-mce-fragment=\"1\">.</span></div>\n<!-- 第四条 -->\n<h3 class=\"pct_st\"></h3>\n<h3 class=\"pct_st\" data-mce-fragment=\"1\">In the Box</h3>\n<div class=\"pct pct_mc\" data-mce-fragment=\"1\">\n<div class=\"pct_t-tb\" data-mce-fragment=\"1\">\n<table class=\"pct_tb\" data-mce-fragment=\"1\" style=\"height: 95px;\"><!-- 表头 -->\n<tbody data-mce-fragment=\"1\">\n<tr class=\"pct_tr\" data-mce-fragment=\"1\" style=\"height: 19px;\">\n<td class=\"pct_td\" data-mce-fragment=\"1\" style=\"height: 19px; width: 483.42px;\"><strong data-mce-fragment=\"1\">