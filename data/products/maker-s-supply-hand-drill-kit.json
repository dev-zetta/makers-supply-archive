  "description_blocks": [
    {
      "kind": "heading",
      "text": "Fine‑Tune Print Tolerances with Precision"
    },
    {
      "kind": "paragraph",
      "text": "Even with well‑calibrated printers, hole dimensions in FDM prints can vary slightly depending on material shrinkage, cooling, and layer orientation. This manual precision drill helps you carefully enlarge holes and refine tolerances without damaging delicate structures."
    },
    {
      "kind": "heading",
      "text": "Manual Drilling for Better Control on Printed Parts"
    },
    {
      "kind": "paragraph",
      "text": "Small printed features or thin walls can crack easily when using powered drills. The manual drilling design provides direct tactile feedback, allowing you to gradually remove material and maintain precise control."
    },
    {
      "kind": "heading",
      "text": "Smooth Rotation with Stable Force Control"
    },
    {
      "kind": "paragraph",
      "text": "The anodized aluminum handle features a comfortable weighted grip, while the rear cap integrates a precision bearing. This allows the drill to rotate smoothly against your palm, improving stability and alignment when working with tiny holes."
    },
    {
      "kind": "heading",
      "text": "Tungsten Steel Bits with Quick Identification"
    },
    {
      "kind": "paragraph",
      "text": "Made from high‑hardness tungsten steel, the bits maintain sharp edges for clean cuts in PLA, PETG, and ABS. Intuitive color‑coded rings and laser‑engraved markings make it easy to quickly find the exact size you need."
    },
    {
      "kind": "heading",
      "text": "Optimized Size Range for 3D Printing Tasks"
    },
    {
      "kind": "paragraph",
      "text": "The hand drill handle is compatible with bits from 0.3 to 3.2 mm, and the included drill bit set covers commonly used sizes for 3D printing post-processing. It is ideal for clearing partially closed pilot holes, refining screw fits, and handling other precise manual drilling tasks."
    },
    {
      "kind": "heading",
      "text": "Consideration"
    },
    {
      "kind": "paragraph",
      "text": "To ensure safe and optimal performance:"
    },
    {
      "kind": "paragraph",
      "text": "When Using Small Bits (0.3 mm / 0.5 mm)"
    },
    {
      "kind": "bullet",
      "text": "Use light pressure; excessive force may cause breakage"
    },
    {
      "kind": "bullet",
      "text": "Avoid drilling high-hardness materials with micro bits"
    },
    {
      "kind": "paragraph",
      "text": "General Safety & Usage"
    },
    {
      "kind": "bullet",
      "text": "Always tighten the chuck manually before use to secure the bit"
    },
    {
      "kind": "bullet",
      "text": "Use safety goggles to protect against flying debris"
    },
    {
      "kind": "bullet",
      "text": "For uneven surfaces, use a guide sleeve to prevent bit deflection"
    },
    {
      "kind": "bullet",
      "text": "If a bit is dropped, inspect for cracks—replace if damaged"
    },
    {
      "kind": "bullet",
      "text": "For high-accuracy drilling, pair with a dedicated model drilling stand"
    }
  ],
  "description_html": "<div class=\"pct pct_mc\">\n<div class=\"pct_tpc-ic\">\n<div>\n<h3 class=\"pct_t\">Fine‑Tune Print Tolerances with Precision</h3>\n<p class=\"pct_p\" style=\"text-align: left;\">Even with well‑calibrated printers, hole dimensions in FDM prints can vary slightly depending on material shrinkage, cooling, and layer orientation. This manual precision drill helps you carefully enlarge holes and refine tolerances without damaging delicate structures.</p>\n</div>\n<div class=\"pct_ic\"><!-- 手机端图片 --> <img alt=\"图片加载失败文案\" class=\"pct_mi product-desc-lazy-media product-desc-lazy-media--image bg-bbl-white animate-pulse max-h-[400px]\" data-lazy=\"false\" data-src=\"https://store.bblcdn.com/s1/default/c7544ba688a34112901927b86a00abae/1.png\" src=\"data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjQiIGhlaWdodD0iMjQiIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj4KPHJlY3Qgd2lkdGg9IjI0IiBoZWlnaHQ9IjI0IiBmaWxsPSIjRkZGRkZGIi8+Cjwvc3ZnPgo=\"/> <!-- PC端图片 --> <img alt=\"图片加载失败文案\" class=\"pct_i product-desc-lazy-media product-desc-lazy-media--image bg-bbl-white animate-pulse max-h-[400px]\" data-lazy=\"false\" data-src=\"https://store.bblcdn.com/s1/default/c7544ba688a34112901927b86a00abae/1.png\" src=\"data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjQiIGhlaWdodD0iMjQiIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj4KPHJlY3Qgd2lkdGg9IjI0IiBoZWlnaHQ9IjI0IiBmaWxsPSIjRkZGRkZGIi8+Cjwvc3ZnPgo=\"/></div>\n</div>\n<!-- 第二条 -->\n<div class=\"pct pct_mc\">\n<div class=\"pct_t-stpcic\">\n<div class=\"pct_stpc-ic\">\n<div class=\"pct_ic\"><!-- 手机端图片 --> <video autoplay=\"autoplay\" class=\"product-desc-lazy-media product-desc-lazy-media--video bg-bbl-white animate-pulse aspect-video max-h-[400px]\" data-lazy=\"false\" data-src=\"https://store.bblcdn.com/s1/default/f443906c4fe54f328b808909dfe0dd31/Hand_Drill_Kit.mp4\" height=\"150\" loop=\"loop\" muted=\"\" playsinline=\"\" poster=\"data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjQiIGhlaWdodD0iMjQiIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj4KPHJlY3Qgd2lkdGg9IjI0IiBoZWlnaHQ9IjI0IiBmaWxsPSIjRkZGRkZGIi8+Cjwvc3ZnPgo=\" style=\"width: 100%; height: 100%; object-fit: cover;\" width=\"300\">\n</video> <!-- PC端图片 --></div>\n<div class=\"pct_st-p\">\n<h3 class=\"pct_st\">Manual Drilling for Better Control on Printed Parts</h3>\n<p class=\"pct_p\">Small printed features or thin walls can crack easily when using powered drills. The manual drilling design provides direct tactile feedback, allowing you to gradually remove material and maintain precise control.</p>\n</div>\n</div>\n</div>\n</div>\n<!-- 第三条 -->\n<div class=\"pct pct_mc\">\n<div class=\"pct_stpc-ic\"><!-- 左侧文案部分 -->\n<div class=\"pct_st-p\">\n<h3 class=\"pct_st\">Smooth Rotation with Stable Force Control</h3>\n<p class=\"pct_p\">The anodized aluminum handle features a comfortable weighted grip, while the rear cap integrates a precision bearing. This allows the drill to rotate smoothly against your palm, improving stability and alignment when working with tiny holes.</p>\n</div>\n<!-- 右侧图片部分 -->\n<div class=\"pct_ic\"><!-- 手机端图片 --> <img alt=\"图片加载失败文案\" class=\"pct_mi product-desc-lazy-media product-desc-lazy-media--image bg-bbl-white animate-pulse max-h-[400px]\" data-lazy=\"false\" data-src=\"https://store.bblcdn.com/s1/default/937e02eee6d344b4b681c5ea0c27173a/3.png\" src=\"data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjQiIGhlaWdodD0iMjQiIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj4KPHJlY3Qgd2lkdGg9IjI0IiBoZWlnaHQ9IjI0IiBmaWxsPSIjRkZGRkZGIi8+Cjwvc3ZnPgo=\"/> <!-- PC端图片 --> <img alt=\"图片加载失败文案\" class=\"pct_i product-desc-lazy-media product-desc-lazy-media--image bg-bbl-white animate-pulse max-h-[400px]\" data-lazy=\"false\" data-src=\"https://store.bblcdn.com/s1/default/937e02eee6d344b4b681c5ea0c27173a/3.png\" src=\"data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjQiIGhlaWdodD0