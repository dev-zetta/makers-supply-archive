  "description_blocks": [
    {
      "kind": "heading",
      "text": "Introduction"
    },
    {
      "kind": "paragraph",
      "text": "The SH1.0 to SH1.0 Connector Adapter Board facilitates seamless SH1.0 connection, delivering reliable signal and power transmission for compact devices and modular systems. It can also be paired with a Wire Pair with SH1.0 connectors, serving as an extension kit for enhanced SH1.0 connection capabilities."
    },
    {
      "kind": "heading",
      "text": "Application"
    },
    {
      "kind": "bullet",
      "text": "Embedded system development: Ideal for prototyping and integrating components in embedded system projects."
    },
    {
      "kind": "bullet",
      "text": "Circuit debugging and testing: Simplifies troubleshooting and ensures reliable circuit performance during testing."
    },
    {
      "kind": "bullet",
      "text": "Modular device interconnections: Enables seamless connectivity between modular devices for efficient integration."
    },
    {
      "kind": "bullet",
      "text": "Signal and power transmission for compact devices: Ensures stable signal and power flow in space-constrained device setups."
    },
    {
      "kind": "heading",
      "text": "Important Notices"
    },
    {
      "kind": "bullet",
      "text": "Pin alignment: Ensure correct pin alignment when connecting cables. Reversing the polarity may cause short circuits and damage connected devices."
    },
    {
      "kind": "bullet",
      "text": "Choking hazard: This product contains small parts. Keep out of reach of children to avoid accidental ingestion."
    }
  ],
  "description_html": "<div class=\"pct pct_mc\">\n<h2 class=\"pct_st\"></h2>\n<h2 class=\"pct_st\"></h2>\n<h2 class=\"pct_t\">Documentation</h2>\n<h2 class=\"pct_st\"></h2>\n<p class=\"pct_padding-in-mobile pct_downloadContent\" style=\"text-align: center; gap: 40px; display: flex; justify-content: center;\"><!-- 3D Model --><a href=\"https://cdn.shopify.com/s/files/1/0584/7236/6216/files/SH1.0_to_SH1.0_Connector_Adapter_Board_-_XA013_Model.zip?v=1737367063\" rel=\"noopener\" style=\"color: #333333; font-weight: 600; display: flex; justify-content: center; align-items: center; gap: 20px;\" target=\"_blank\"> <img alt=\"3D\" class=\"download_svg product-desc-lazy-media product-desc-lazy-media--image bg-bbl-white animate-pulse max-h-[400px]\" data-lazy=\"false\" data-src=\"https://cdn.shopify.com/s/files/1/0611/4036/9460/files/3d.svg?v=1715161943\" src=\"data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjQiIGhlaWdodD0iMjQiIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj4KPHJlY3Qgd2lkdGg9IjI0IiBoZWlnaHQ9IjI0IiBmaWxsPSIjRkZGRkZGIi8+Cjwvc3ZnPgo=\"/> <span>3D Model</span> </a><!-- Introduction --></p>\n<br/>\n<div class=\"pct pct_mc\">\n<div class=\"pct_st-tbc\">\n<div class=\"pct_tbc\">\n<div class=\"pct pct_mc\">\n<div class=\"pct_padding-in-mobile\">\n<div class=\"pct_st-p\">\n<h2 class=\"pct_t\" style=\"text-align: left;\"><strong>Introduction</strong></h2>\n<div data-docx-has-block-data=\"false\" data-lark-html-role=\"root\" data-page-id=\"NWFEdTdraotwGWx8BemcxlFinug\">\n<div class=\"old-record-id-ZMy0dGgjFoKF7YxnkxRcb6YInV1\">\n<div data-docx-has-block-data=\"false\" data-lark-html-role=\"root\" data-page-id=\"NWFEdTdraotwGWx8BemcxlFinug\">\n<div class=\"ace-line ace-line old-record-id-ZMy0dGgjFoKF7YxnkxRcb6YInV1\">The SH1.0 to SH1.0 Connector Adapter Board facilitates seamless SH1.0 connection, delivering reliable signal and power transmission for compact devices and modular systems. It can also be paired with a <a href=\"https:/