x;\">1</td>\n</tr>\n<tr class=\"pct_tr\">\n<td class=\"pct_td\" style=\"border: 1px solid #cccccc; padding: 10px;\">7</td>\n<td class=\"pct_td\" style=\"border: 1px solid #cccccc; padding: 10px;\">Cleaning Sponge with Holder</td>\n<td class=\"pct_td\" style=\"border: 1px solid #cccccc; padding: 10px;\">1</td>\n</tr>\n<tr class=\"pct_tr\">\n<td class=\"pct_td\" style=\"border: 1px solid #cccccc; padding: 10px;\">8</td>\n<td class=\"pct_td\" style=\"border: 1px solid #cccccc; padding: 10px;\">Premium Travel Case</td>\n<td class=\"pct_td\" style=\"border: 1px solid #cccccc; padding: 10px;\">1</td>\n</tr>\n</tbody>\n</table>\n</div>\n</div>\n</div>\n<div class=\"pct pct_mc\">\n<div class=\"pct_st-tbc\">\n<h3 class=\"pct_st\"><span style=\"font-size: 24px;\">Heat-Stake Nut Tool Tip Set</span></h3>\n<div class=\"pct_tbc\">\n<div class=\"TableWrapper\">\n<table class=\"pct_tb\" style=\"height: 477px;\"><!-- 表头 -->\n<thead class=\"pct_th\">\n<tr style=\"height: 27px;\">\n<td class=\"pct_td\" style=\"background-color: #c7c7c7; color: #333333; border-color: #adadad; text-align: center; width: 102.637px; height: 27px;\">Size</td>\n<td class=\"pct_td\" style=\"background-color: #c7c7c7; color: #333333; border-color: #adadad; text-align: center; width: 125.35px; height: 27px;\">Tip Diameter (mm)</td>\n<td class=\"pct_td\" style=\"background-color: #c7c7c7; color: #333333; border-color: #adadad; text-align: center; width: 241.488px; height: 27px;\">Total Length (mm)</td>\n<td class=\"pct_td\" style=\"background-color: #c7c7c7; color: #333333; border-color: #adadad; text-align: center; width: 83.425px; height: 27px;\">Quantity</td>\n<td class=\"pct_td\" style=\"background-color: #c7c7c7; color: #333333; border-color: #adadad; text-align: center; width: 161.7px; height: 27px;\">Material</td>\n</tr>\n</thead>\n<tbody>\n<tr class=\"pct_tr\" style=\"height: 50px;\">\n<td class=\"pct_td\" style=\"text-align: center; height: 50px; width: 102.637px;\">M2</td>\n<td class=\"pct_td\" style=