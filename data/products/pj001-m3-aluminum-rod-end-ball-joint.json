  "description_blocks": [
    {
      "kind": "heading",
      "text": "Introduction"
    },
    {
      "kind": "paragraph",
      "text": "This Aluminum Alloy Rod End Ball Joint is a premium-grade component designed for precision and durability. Made from high-strength aluminum alloy, it offers excellent wear resistance, corrosion protection, and lightweight performance. This ball joint is ideal for RC cars, robotics, and 3D printing projects, providing smooth and reliable pivot points for mechanical assemblies. Compatible with Carbon Steel Full-Thread Rod, it can be easily integrated into various designs, offering flexibility and convenience for makers and hobbyists."
    },
    {
      "kind": "heading",
      "text": "Product Feature"
    },
    {
      "kind": "bullet",
      "text": "High-Quality Aluminum Alloy: Made from durable aluminum alloy, offering excellent corrosion resistance, wear protection, and a lightweight design."
    },
    {
      "kind": "bullet",
      "text": "Smooth & Precise Movement: The ball joint ensures smooth articulation, making it ideal for RC car suspensions, steering systems, and other pivot-based mechanisms."
    },
    {
      "kind": "bullet",
      "text": "Flexible & Practical Applications: Compatible with fully threaded rods, making assembly easy and secure. Ideal for RC car upgrades, robotics, and custom 3D-printed projects requiring reliable pivoting components."
    },
    {
      "kind": "heading",
      "text": "Important Notices"
    },
    {
      "kind": "bullet",
      "text": "Torque limit: Do not overtighten the M3 screws when installing the ball joint to prevent stripping the aluminum threads."
    },
    {
      "kind": "bullet",
      "text": "Choking hazard: This product contains small parts. Keep out of reach of children to avoid accidental ingestion."
    }
  ],
  "description_html": "<div class=\"pct pct_mc\">\n<h2 class=\"pct_st\"></h2>\n<h2 class=\"pct_st\"></h2>\n<h2 class=\"pct_t\"><span style=\"vertical-align: inherit;\"><span style=\"vertical-align: inherit;\">Documentation</span></span></h2>\n<h2 class=\"pct_st\"></h2>\n<p class=\"pct_padding-in-mobile pct_downloadContent\" style=\"text-align: center; gap: 40px; display: flex; justify-content: center;\"><!-- Specification --><a href=\"https://store.bblcdn.com/s7/default/44361ed8254c4630b818f46d603fe350/B-PJ001-specification.pdf\" rel=\"noopener\" style=\"color: #333333; font-weight: 600; display: flex; justify-content: center; align-items: center; gap: 20px;\" target=\"_blank\"> <img alt=\"2D\" class=\"download_svg product-desc-lazy-media product-desc-lazy-media--image bg-bbl-white animate-pulse max-h-[400px]\" data-lazy=\"false\" data-src=\"https://store.bblcdn.com/s7/default/1ed6b71b4c814ac3bc34933673003555/2d.svg\" src=\"data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjQiIGhlaWdodD0iMjQiIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj4KPHJlY3Qgd2lkdGg9IjI0IiBoZWlnaHQ9IjI0IiBmaWxsPSIjRkZGRkZGIi8+Cjwvc3ZnPgo=\"/> <span><span style=\"vertical-align: inherit;\"><span style=\"vertical-align: inherit;\">Specification</span></span></span> </a> <!-- 3D Model --><a href=\"https://store.bblcdn.com/s7/default/f9e6a6d351cb4e13aa0dd05a76230db1/M3_Aluminum_Ball_Joint_Rod_End_-_PJ001_Model.zip\" rel=\"noopener\" style=\"color: #333333; font-weight: 600; display: flex; justify-content: center; align-items: center; gap: 20px;\" target=\"_blank\"> <img alt=\"3D\" class=\"download_svg product-desc-lazy-media product-desc-lazy-media--image bg-bbl-white animate-pulse max-h-[400px]\" data-lazy=\"false\" data-src=\"https://store.bblcdn.com/s7/default/34cfd495f6e74bb59595d83a7b486516/3d.svg\" src=\"data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjQiIGhlaWdodD0iMjQiIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj4K