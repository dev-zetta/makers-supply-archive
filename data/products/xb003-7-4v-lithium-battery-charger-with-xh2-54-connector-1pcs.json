  "description_blocks": [
    {
      "kind": "heading",
      "text": "Introduction"
    },
    {
      "kind": "paragraph",
      "text": "This charger is equipped with a standard XH2.54 connector and is suitable for charging the 14500 7.4V 800mAh Li-ion Battery. It is widely used in battery-powered applications such as model toys, small robots, and DIY projects."
    },
    {
      "kind": "heading",
      "text": "Product Features"
    },
    {
      "kind": "bullet",
      "text": "Output short-circuit and reverse polarity protection."
    },
    {
      "kind": "bullet",
      "text": "LED Indicator Status: Indicator is off when power is connected / Red LED lights up during charging / Red LED turns off when charging is complete"
    },
    {
      "kind": "heading",
      "text": "Important Notices"
    },
    {
      "kind": "bullet",
      "text": "The USB charger for this product only supports standard 5V 1-2A input. Please always use the original charger that meets the voltage/current requirements, or charge directly via a computer USB port. Do not use chargers with output higher than 5V or 2A (such as mobile fast chargers, 9V/12V adapters, etc.), as this may cause device damage, overheating, or even serious fire hazards. Do not cover the device while charging, and keep it away from high temperature, humidity, or flammable environments. Never charge the device unattended."
    },
    {
      "kind": "bullet",
      "text": "The company is not responsible for any device damage, malfunction, fire, or other losses resulting from failure to comply with the above requirements. Please strictly follow the safety instructions for this product."
    }
  ],
  "description_html": "<div class=\"pct pct_mc\">\n<div class=\"pct_tpc-ic\">\n<div class=\"pct_t-p\">\n<h2 class=\"pct_t\" style=\"margin-top: 30px; margin-bottom: 20px; text-align: center; font-size: 24px;\">Documentation</h2>\n<p class=\"pct_padding-in-mobile pct_downloadContent\" style=\"text-align: center; gap: 40px; display: flex; justify-content: center;\"><!--规格参数--><a href=\"https://store.bblcdn.com/s1/default/917b748ea20f40c5aa77050b60910435/XB003_Specification.pdf\" rel=\"noopener\" style=\"color: #333333; font-weight: 600; display: flex; justify-content: center; align-items: center; gap: 20px;\" target=\"_blank\"> <img alt=\"2D\" class=\"download_svg product-desc-lazy-media product-desc-lazy-media--image bg-bbl-white animate-pulse max-h-[400px]\" data-lazy=\"false\" data-src=\"https://cdn.shopify.com/s/files/1/0611/4036/9460/files/2d.svg?v=1715161943\" src=\"data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjQiIGhlaWdodD0iMjQiIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj4KPHJlY3Qgd2lkdGg9IjI0IiBoZWlnaHQ9IjI0IiBmaWxsPSIjRkZGRkZGIi8+Cjwvc3ZnPgo=\"/> <span>Specifications</span> </a></p>\n</div>\n</div>\n</div>\n<div class=\"pct pct_mc\">\n<div class=\"pct_ic\">\n<div class=\"pct pct_mc\">\n<div class=\"pct_tpc-ic\">\n<div class=\"pct_t-p\">\n<p class=\"pct_p\" style=\"text-align: center;\"><span style=\"color: #95a5a6;\"><em>*Specifications: Essential electrical and physical parameters required for proper operation.</em></span></p>\n</div>\n</div>\n<!--Introduction-->\n<h2 class=\"pct_t\" style=\"margin-top: 20px; font-size: 24px; text-align: left;\">Introduction</h2>\n<!---红字文本替换---->\n<p class=\"pct_p\" style=\"text-align: left;\">This charger is equipped with a standard XH2.54 connector and is suitable for charging the <a href=\"https://us.store.bambulab.com/preview/product?pid=4cb2f9b241634d78aa47eb2a7ad0d230&amp;skr=yes\" rel=\"noopener\" target=\"_blank\"><span style=\"text-decoration: underline; color: #00ae42;\"