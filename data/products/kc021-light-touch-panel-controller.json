  "description_blocks": [
    {
      "kind": "heading",
      "text": "Introduction"
    },
    {
      "kind": "paragraph",
      "text": "The Light Touch Panel Controller is a replacement part for the White CCT Tunable COB LED Strip Light, perfect for replacing lost or damaged controllers. It provides seamless control and enhanced convenience for your DIY lighting projects."
    },
    {
      "kind": "heading",
      "text": "Product Features"
    },
    {
      "kind": "bullet",
      "text": "Effect Modes: 26 dynamic effects, including unique features like running water effects at startup and backflow effects at shutdown."
    },
    {
      "kind": "bullet",
      "text": "Color Temperature Range: Full-spectrum stepless dimming from 2700K to 6500K, offering options for color temperature adjustment, running effects, trailing, and gradients. Brightness is fully adjustable."
    },
    {
      "kind": "bullet",
      "text": "Remote Control Distance: Operates up to 20 meters away for added convenience."
    },
    {
      "kind": "bullet",
      "text": "Battery Type: Powered by a CR2025 battery."
    },
    {
      "kind": "heading",
      "text": "Considerations"
    },
    {
      "kind": "bullet",
      "text": "This product is not a toy. Please keep it out of reach of children."
    }
  ],
  "description_html": "<div class=\"pct pct_mc\">\n<div class=\"pct_st-tbc\">\n<h2 class=\"ace-line ace-line old-record-id-Ehmbdrk2hozxYux3qzicNdKznrR\" style=\"text-align: left;\">Introduction</h2>\n<p> </p>\n<div class=\"ace-line ace-line old-record-id-Ehmbdrk2hozxYux3qzicNdKznrR\">The Light Touch Panel Controller is a replacement part for the <span style=\"color: #000000;\"><a href=\"https://eu.store.bambulab.com/products/white-cct-tunable-cob-led-strip-light?id=41623262199923&amp;skr=yes\" rel=\"noopener\" target=\"_blank\"><span style=\"color: #00ae42;\">White CCT Tunable COB LED Strip Light</span></a> , perfect for replacing lost or damaged controllers. It provides seamless control and enhanced convenience for your DIY lighting projects.</span></div>\n<div class=\"ace-line ace-line old-record-id-Ehmbdrk2hozxYux3qzicNdKznrR\"><span style=\"color: #000000;\"></span></div>\n<p class=\"pct_padding-in-mobile pct_downloadContent\" style=\"text-align: center; gap: 40px; display: flex; justify-content: center;\"> </p>\n</div>\n</div>\n<div class=\"pct pct_mc\">\n<h2 style=\"text-align: left;\">Product Features</h2>\n<p> </p>\n<div data-docx-has-block-data=\"false\" data-lark-html-role=\"root\" data-page-id=\"BraMdd9z6owwkNxjI3McPYx2nsb\">\n<div data-docx-has-block-data=\"false\" data-lark-html-role=\"root\" data-page-id=\"BraMdd9z6owwkNxjI3McPYx2nsb\">\n<ul class=\"list-bullet1\">\n<li class=\"ace-line ace-line old-record-id-MjOGdFJDho4yaYx4wfocb6Pwn1g\" data-list=\"bullet\">\n<div><span><strong>Effect Modes:</strong></span><span> 26 dynamic effects, including unique features like running water effects at startup and backflow effects at shutdown.</span></div>\n</li>\n<li class=\"ace-line ace-line old-record-id-JsbBdwQm2oiLaQxv8IscjZtfnMg\" data-list=\"bullet\">\n<div><span><strong>Color Temperature Range:</strong></span><span> Full-spectrum stepless dimming from 2700K to 6500K, offering options for color temperature adjustment, running effects, trailing, and gradients. Brightness is fully adjustable.</span></div>\n</li>\n<li class=\"ace-line ace-line old-record-id-XjgwdkpVmo2jhOxyowbc4AOzn6e\" data-list=\"bullet\">\n<div><span><strong>Remote Control Distance:</strong></span><span> Operates up to 20 meters away for added convenience.</span></div>\n</li>\n<li class=\"ace-line ace-line old-record-id-ZcjedHZJeocqE8x2GP9crIe5nJd\" data-list=\"bullet\">\n<div><span><strong>Battery Type:</strong></span><span> Powered by a CR2025 battery.</span></div>\n</li>\n</ul>\n</div>\n</div>\n<h2 style=\"text-align: left;\"></h2>\n<h2 style=\"text-align: center;\">Light Touch Panel Controller Instructions</h2>\n<p> </p>\n<p><img alt=\"\" class=\"product-desc-lazy-media product-desc-lazy-media--image bg-bbl-white animate-pulse aspect-video max-h-[400px]\" data-lazy=\"false\" data-src=\"https://store.bblcdn.eu/s8/default/aa4c5fb61b05426f9322fc9e9b731118/Group_48397.png\" src=\"data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjQiIGhlaWdodD0iMjQiIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj4KPHJlY3Qgd2lkdGg9IjI0IiBoZWlnaHQ9IjI0IiBmaWxsPSIjRkZGRkZGIi8+Cjwvc3ZnPgo=\"/></p>\n<h2 style=\"text-align: left;\"></h2>\n<p> </p>\n<h2 style=\"text-align: left;\">Considerations</h2>\n<div data-docx-has-block-data=\"false\" data-lark-html-role=\"root\" data-page-id=\"BraMdd9z6owwkNxjI3McPYx2nsb\">\n<ul class=\"list-bullet1\">\n<li class=\"ace-line ace-line old-record-id-PHyzdzp6eoQmNExKj8Zczt2ynb0\" data-list=\"bullet\">\n<div>This product is not a toy. Please keep it out of reach of children.</div>\n</li>\n</ul>\n</div>\n<p> </p>\n</div>",
  "description_text": "The Light Touch Panel Controller is a replacement part for the White CCT Tunable COB LED Strip Light, perfect for replacing lost or damaged controllers. It provides seamless control and enhanced convenience for your DIY lighting projects.\n\nEffect Modes: 26 dynamic effects, including unique features like running water effects at startup and backflow effects at shutdown.\n\nColor Temperature Range: Full-spectrum stepless dimming from 2700K to 6500K, offering options for color temperature adjustment, running effects, trailing, and gradients. Brightness is fully adjustable.\n\nRemote Control Distance: Operates up to 20 meters away for added convenience.\n\nBattery Type: Powered by a CR2025 battery.\n\nThis product is not a toy. Please keep it out of reach of children.",
