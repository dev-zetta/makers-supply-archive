width: 20%; height: 18px; text-align: center;\"><span style=\"color: #000000;\">1</span></td>\n</tr>\n<tr class=\"pct_tr\" style=\"height: 18px;\">\n<td class=\"pct_td\" style=\"width: 20%; height: 18px; text-align: left;\"><a href=\"../../../products/cob-led-strip-light?id=42799127691400\" rel=\"noopener\" target=\"_blank\"><span style=\"color: #00ae42;\"><b>300x1mm COB LED Strip Light (1PCS) - KA009</b></span></a></td>\n<td class=\"pct_td\" style=\"width: 20%; height: 18px; text-align: center;\"><span style=\"color: #000000;\">2</span></td>\n<td class=\"pct_td\" style=\"width: 20%; height: 18px; text-align: center;\"><span style=\"color: #000000;\">2</span></td>\n</tr>\n<tr class=\"pct_tr\" style=\"height: 18px;\">\n<td class=\"pct_td\" style=\"width: 20%; height: 18px; text-align: left;\"><a href=\"../../../products/cob-led-strip-light?id=42645878341768\" rel=\"noopener\" target=\"_blank\"><span style=\"color: #00ae42;\"><b>200x1mm COB LED Strip Light (1PCS) - KA008</b></span></a></td>\n<td class=\"pct_td\" style=\"width: 20%; height: 18px; text-align: center;\"><span style=\"color: #000000;\">1</span></td>\n<td class=\"pct_td\" style=\"width: 20%; height: 18px; text-align: center;\"><span style=\"color: #000000;\">1</span></td>\n</tr>\n<tr class=\"pct_tr\" style=\"height: 18px;\">\n<td class=\"pct_td\" style=\"width: 20%; height: 18px; text-align: left;\"><a href=\"../../../products/black-nylon-cord\" rel=\"noopener\" target=\"_blank\"><span style=\"color: #00ae42;\"><b>0.6mm Black Nylon Cord 5m (1pcs) - MF001</b></span></a></td>\n<td class=\"pct_td\" style=\"width: 20%; height: 18px; text-align: center;\"><span style=\"color: #000000;\">1</span></td>\n<td class=\"pct_td\" style=\"width: 20%; height: 18px; text-align: center;\"><span style=\"color: #000000;\">1</span></td>\n</tr>\n<tr class=\"pct_tr\" style=\"height: 18px;\">\n<td class=\"pct_td\" style=\"width: 20%; height: 18px; text-align: left;\"><a href=\"../../../products/battery-case?id=42122903781512\" r