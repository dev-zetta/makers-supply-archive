  "description_blocks": [
    {
      "kind": "heading",
      "text": "Introduction"
    },
    {
      "kind": "paragraph",
      "text": "Crafted from high-strength carbon steel, the L Type Hex Wrench delivers exceptional durability and resistance to deformation. Its ergonomic L-shaped design leverages the lever principle for greater torque and effortless operation—perfect for quickly installing or removing hex screws in various repair and assembly scenarios."
    }
  ],
  "description_html": "<div class=\"pct pct_mc\">\n<div class=\"pct_st-tbc\">\n<div class=\"pct_tbc\">\n<div class=\"pct pct_mc\">\n<div class=\"pct_padding-in-mobile\">\n<div class=\"pct_st-p\">\n<h2 class=\"pct_t\" style=\"text-align: left;\"><br/><strong>Introduction</strong></h2>\n<p class=\"pct_p\">Crafted from high-strength carbon steel, the L Type Hex Wrench delivers exceptional durability and resistance to deformation. Its ergonomic L-shaped design leverages the lever principle for greater torque and effortless operation—perfect for quickly installing or removing hex screws in various repair and assembly scenarios.</p>\n</div>\n<!-- 图片模块 （Banner）-->\n<p class=\"pct_p\" style=\"text-align: center;\"></p>\n<p class=\"pct_p\" style=\"text-align: center;\"><img class=\"product-desc-lazy-media product-desc-lazy-media--image bg-bbl-white animate-pulse aspect-video max-h-[400px]\" data-lazy=\"false\" data-src=\"https://store.bblcdn.com/s1/default/bdf8f3af06bc4cbe97f42362ba831294/L-Type_H2.5_-_QA006.png\" src=\"data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjQiIGhlaWdodD0iMjQiIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj4KPHJlY3Qgd2lkdGg9IjI0IiBoZWlnaHQ9IjI0IiBmaWxsPSIjRkZGRkZGIi8+Cjwvc3ZnPgo=\"/></p>\n</div>\n</div>\n</div>\n</div>\n</div>",
  "description_text": "Crafted from high-strength carbon steel, the L Type Hex Wrench delivers exceptional durability and resistance to deformation. Its ergonomic L-shaped design leverages the lever principle for greater torque and effortless operation—perfect for quickly installing or removing hex screws in various repair and assembly scenarios.",
