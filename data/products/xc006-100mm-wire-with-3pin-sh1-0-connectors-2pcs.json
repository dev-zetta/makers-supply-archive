  "description_blocks": [
    {
      "kind": "heading",
      "text": "Introduction"
    },
    {
      "kind": "paragraph",
      "text": "Peripheral connection cable - SH1.0-3PIN is commonly used for signal transmission between miniature modules and control boards that support the SH1.0 interface. It is compatible with 1.0mm pitch sockets, making it suitable for space-constrained electronic projects."
    },
    {
      "kind": "heading",
      "text": "Consideration"
    },
    {
      "kind": "bullet",
      "text": "Please hold the connector when plugging and unplugging, and do not forcefully twist the connectors to avoid wires loosening or detaching."
    }
  ],
