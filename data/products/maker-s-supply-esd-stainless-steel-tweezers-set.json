  "description_blocks": [
    {
      "kind": "heading",
      "text": "Precision Handling for 3D Printing Details"
    },
    {
      "kind": "paragraph",
      "text": "Removing fine supports, clearing filament strings, or positioning tiny printed parts often requires more control than fingers can provide. This precision stainless steel tweezer set helps you handle delicate post‑processing tasks with accuracy."
    },
    {
      "kind": "heading",
      "text": "Multiple Tip Styles for Different Print Tasks"
    },
    {
      "kind": "paragraph",
      "text": "Different tip geometries are designed to handle specific situations in 3D printing. Fine straight tips allow precise gripping of small supports and filament strands, while angled tips make it easier to reach tight corners and recessed areas inside complex prints."
    },
    {
      "kind": "heading",
      "text": "Safe Handling Around Hotends & Small Parts"
    },
    {
      "kind": "paragraph",
      "text": "The slim stainless steel tips allow careful manipulation around tight spaces such as nozzles, cooling ducts, or small assemblies. Whether removing stray filament from a heated nozzle or positioning tiny printed components, the tweezers provide the precision needed to work safely."
    },
    {
      "kind": "heading",
      "text": "Consideration"
    },
    {
      "kind": "bullet",
      "text": "Avoid using hard alloys or fiberglass to prevent tip damage."
    },
    {
      "kind": "bullet",
      "text": "Suitable for plastics, resins, and soft metals (hardness ≤150 HV)."
    },
    {
      "kind": "bullet",
      "text": "Always replace protective caps after use to maintain tip precision and safety."
    }
  ],
  "description_html": "<div class=\"pct pct_mc\">\n<div class=\"pct_tpc-ic\">\n<div class=\"pct_t-p\">\n<h3 class=\"pct_t\">Precision Handling for 3D Printing Details</h3>\n<p class=\"pct_p\">Removing fine supports, clearing filament strings, or positioning tiny printed parts often requires more control than fingers can provide. This precision stainless steel tweezer set helps you handle delicate post‑processing tasks with accuracy.</p>\n</div>\n<div class=\"pct_ic\"><!-- 手机端图片 --> <img alt=\"图片加载失败文案\" class=\"pct_mi product-desc-lazy-media product-desc-lazy-media--image bg-bbl-white animate-pulse max-h-[400px]\" data-lazy=\"false\" data-src=\"https://store.bblcdn.com/s1/default/a97e074d23ad40f89df8aee4dc87db9a/1.jpg\" src=\"data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjQiIGhlaWdodD0iMjQiIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj4KPHJlY3Qgd2lkdGg9IjI0IiBoZWlnaHQ9IjI0IiBmaWxsPSIjRkZGRkZGIi8+Cjwvc3ZnPgo=\"/> <!-- PC端图片 --> <img alt=\"图片加载失败文案\" class=\"pct_i product-desc-lazy-media product-desc-lazy-media--image bg-bbl-white animate-pulse max-h-[400px]\" data-lazy=\"false\" data-src=\"https://store.bblcdn.com/s1/default/a97e074d23ad40f89df8aee4dc87db9a/1.jpg\" src=\"data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjQiIGhlaWdodD0iMjQiIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj4KPHJlY3Qgd2lkdGg9IjI0IiBoZWlnaHQ9IjI0IiBmaWxsPSIjRkZGRkZGIi8+Cjwvc3ZnPgo=\"/></div>\n</div>\n<!-- 第二条 -->\n<div class=\"pct pct_mc\">\n<div class=\"pct_tpc-ic\">\n<div class=\"pct_t-p\">\n<h3 class=\"pct_t\">Multiple Tip Styles for Different Print Tasks</h3>\n<p class=\"pct_p\">Different tip geometries are designed to handle specific situations in 3D printing. Fine straight tips allow precise gripping of small supports and filament strands, while angled tips make it easier to reach tight corners and recessed areas inside complex prints.</p>\n</div>\n<div class=\"pct_ic\"><!-- 手机端图片 --> <img alt=\"图片加载失败文案\" class=\"pct_mi product-desc-lazy-media product-desc-lazy-media--image bg-bbl-white animate-pulse max-h-[400px]\" data-lazy=\"false\" data-src=\"https://store.bblcdn.com/s1/default/c122cf2b677c43b6b5d763560bfa3839/2.jpg\" src=\"data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjQiIGhlaWdodD0iMjQiIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj4KPHJlY3Qgd2lkdGg9IjI0IiBoZWlnaHQ9IjI0IiBmaWxsPSIjRkZGRkZGIi8+Cjwvc3ZnPgo=\"/> <!-- PC端图片 --> <img alt=\"图片加载失败文案\" class=\"pct_i product-desc-lazy-media product-desc-lazy-media--image bg-bbl-white animate-pulse max-h-[400px]\" data-lazy=\"false\" data-src=\"https://store.bblcdn.com/s1/default/c122cf2b677c43b6b5d763560bfa3839/2.jpg\" src=\"data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjQiIGhlaWdodD0iMjQiIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj4KPHJlY3Qgd2lkdGg9IjI0IiBoZWlnaHQ9IjI0IiBmaWxsPSIjRkZGRkZGIi8+Cjwvc3ZnPgo=\"/></div>\n</div>\n<!-- 第三条 -->\n<div class=\"pct pct_mc\">\n<div class=\"pct_tpc-ic\">\n<div class=\"pct_t-p\">\n<h3 class=\"pct_t\">Safe Handling Around Hotends &amp; Small Parts</h3>\n<p class=\"pct_p\">The slim stainless steel tips allow careful manipulation around tight spaces such as nozzles, cooling ducts, or small assemblies. Whether removing stray filament from a heated nozzle or positioning tiny printed components, the tweezers provide the precision needed to work safely.</p>\n</div>\n<div class=\"pct_ic\"><!-- 手机端图片 --> <img alt=\"图片加载失败文案\" class=\"pct_mi product-desc-lazy-media product-desc-lazy-media--image bg-bbl-white animate-pulse max-h-[400px]\" data-lazy=\"false\" data-src=\"https://store.bblcdn.com/s1/default/3a42248de26c4ddb8df9398c529572a6/3.jpg\" src=\"data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjQiIGhlaWdodD0iMjQiIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj4KPHJlY3Qgd2lkdGg9IjI0IiBoZWlnaHQ9IjI0IiBmaWxsPSIjRkZGRkZGIi8+Cjwvc3ZnPgo=\"/> <!-- PC端图片 --> <img alt=\"图片加载失败文案\" 