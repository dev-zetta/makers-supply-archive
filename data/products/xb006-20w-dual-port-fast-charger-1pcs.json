  "description_blocks": [
    {
      "kind": "heading",
      "text": "Introduction"
    },
    {
      "kind": "paragraph",
      "text": "The 20W Dual-Port Fast Charger delivers quick and efficient charging for your devices. Featuring both USB-A and USB-C ports, it allows you to power two devices simultaneously with a combined output of up to 20W. Compact and lightweight, the two adapters and the main body can be used in European, British and American standard usage scenarios, it’s perfect for use at home, in the office, or while traveling. Compatible with a wide range of smartphones, tablets, and other USB-powered devices, this charger ensures your essentials are always powered and ready to go."
    },
    {
      "kind": "heading",
      "text": "Applications"
    },
    {
      "kind": "bullet",
      "text": "Ideal for charging smartphones, tablets, wireless earbuds, and other USB-powered devices.Supports simultaneous charging of two devices via USB-A and USB-C ports.Perfect for home, office, or travel use thanks to its compact and portable design."
    },
    {
      "kind": "heading",
      "text": "Consideration"
    },
    {
      "kind": "paragraph",
      "text": "The charger's maximum total output is 20W, shared between both ports.When only one device is connected, it can receive up to the full 20W.When two devices are connected, the total 20W output is split between them.Please ensure your devices do not require more power than the charger’s rated output to avoid slower charging or compatibility issues."
    }
  ],
  "description_html": "<div class=\"pct pct_mc\">\n<div class=\"pct_tpc-ic\">\n<div class=\"pct_ic\"></div>\n<div class=\"pct_ic\"> \n<h2 class=\"pct_t\" style=\"text-align: left;\">Introduction</h2>\n<p style=\"text-align: left;\"> </p>\n<p style=\"text-align: left;\">The 20W Dual-Port Fast Charger delivers quick and efficient charging for your devices. Featuring both USB-A and USB-C ports, it allows you to power two devices simultaneously with a combined output of up to 20W. Compact and lightweight, the two adapters and the main body can be used in European, British and American standard usage scenarios, it’s perfect for use at home, in the office, or while traveling. Compatible with a wide range of smartphones, tablets, and other USB-powered devices, this charger ensures your essentials are always powered and ready to go.</p>\n<p style=\"text-align: left;\"> </p>\n<p><img alt=\"\" class=\"product-desc-lazy-media product-desc-lazy-media--image bg-bbl-white animate-pulse aspect-video max-h-[400px]\" data-lazy=\"false\" data-src=\"https://store.bblcdn.com/s1/default/1b8bbc63f86d4b4895ec9e41c21477b4/Frame_1123860832.png\" src=\"data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjQiIGhlaWdodD0iMjQiIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj4KPHJlY3Qgd2lkdGg9IjI0IiBoZWlnaHQ9IjI0IiBmaWxsPSIjRkZGRkZGIi8+Cjwvc3ZnPgo=\"/></p>\n</div>\n</div>\n</div>\n<div class=\"pct pct_mc\">\n<div class=\"pct pct_mc\">\n<div class=\"pct_st-tbc product-specification-table-small-padding\">\n<div class=\"pct_tbc\">\n<table class=\"pct_tb\" style=\"border-color: #adadad; font-weight: bold; width: 90.3285%; height: 123px;\"><!-- 表头 -->\n<thead class=\"pct_th\">\n<tr style=\"height: 50px;\">\n<td class=\"pct_td\" style=\"background-color: #c7c7c7; color: #333333; border-color: #adadad; font-weight: bold; text-align: center; width: 11.8609%; height: 50px;\">\n<div>Product ID</div>\n</td>\n<td class=\"pct_td\" style=\"background-color: #c7c7c7; color: #3333