lass=\"pct_td\" style=\"height: 19px;\"><span style=\"color: #00ae42;\"><a href=\"../../products/round-magnet?id=42424856477832\" rel=\"noopener\" style=\"color: #00ae42;\" target=\"_blank\">D8x2 mm Round Magnet (20PCS) - CA005</a></span></td>\n<td class=\"pct_td\" style=\"height: 19px; width: 20%;\">1</td>\n</tr>\n</tbody>\n</table>\n</div>\n</div>\n</div>\n</div>\n</div>",
