  "description_blocks": [
    {
      "kind": "heading",
      "text": "Introduction"
    },
    {
      "kind": "paragraph",
      "text": "This fitting is perfect for connecting both PTFE (Teflon) tubes, ensuring smooth and consistent flow during your DIY projects."
    },
    {
      "kind": "heading",
      "text": "Considerations"
    },
    {
      "kind": "bullet",
      "text": "Verify that the fitting size matches the diameters of your PTFE (Teflon) tubes to ensure a proper fit."
    },
    {
      "kind": "bullet",
      "text": "Ensure that the tubes are securely inserted into the fitting to prevent any disconnection or leaks."
    },
    {
      "kind": "bullet",
      "text": "Regularly inspect the fitting and connected tubes for any signs of wear or damage, and replace them as necessary to maintain optimal performance."
    }
  ],
  "description_html": "<div class=\"pct pct_mc\">\n<h2 class=\"pct_st\"></h2>\n<h2 class=\"pct_st\"></h2>\n<h2 class=\"pct_t\">Documentation</h2>\n<h2 class=\"pct_st\"></h2>\n<p class=\"pct_padding-in-mobile pct_downloadContent\" style=\"text-align: center; gap: 40px; display: flex; justify-content: center;\"><a href=\"https://store.bblcdn.com/s7/default/b04f75f7718b42bea16a9638482af7fc/PC4-M6_Pneumatic_Connector_for_PTFE_Tube.zip\" rel=\"noopener\" style=\"color: #333333; font-weight: 600; display: flex; justify-content: center; align-items: center; gap: 20px;\" target=\"_blank\"> <img class=\"download_svg\" style=\"color: #333333; font-weight: 600; display: flex; justify-content: center; align-items: center; gap: 20px;\"/> <img alt=\"3D\" class=\"download_svg product-desc-lazy-media product-desc-lazy-media--image bg-bbl-white animate-pulse max-h-[400px]\" data-lazy=\"false\" data-src=\"https://store.bblcdn.com/s7/default/34cfd495f6e74bb59595d83a7b486516/3d.svg\" src=\"data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjQiIGhlaWdodD0iMjQiIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj4KPHJlY3Qgd2lkdGg9IjI0IiBoZWlnaHQ9IjI0IiBmaWxsPSIjRkZGRkZGIi8+Cjwvc3ZnPgo=\"/> 3D Model </a></p>\n</div>\n<div class=\"pct pct_mc\">\n<div class=\"pct_tpc-ic\">\n<div class=\"pct pct_mc\">\n<div class=\"pct_st-tbc product-specification-table-small-padding\">\n<div class=\"pct pct_mc\">\n<div class=\"pct_t-icpc pct_padding-in-mobile .pct_hardware-tableList pct_hardware-tableList-t-icpc\">\n<h2 class=\"pct_t\">Product Specifications</h2>\n<div class=\"pct_icpc pct_grad-2-pc pct_grad-1-mobile pct_hardware-tableList\"><!-- 第一条 -->\n<div class=\"pct_ic-p\"><!-- table布局 -->\n<div class=\"pct pct_mc\">\n<div class=\"pct_st-tbc\" style=\"padding: 0;\">\n<div class=\"pct_tbc\">\n<table class=\"pct_tb\" style=\"width: 100%; margin-top: 0; font-weight: bold;\"><!-- 表头 -->\n<tbody>\n<tr class=\"pct_tr\">\n<td class=\"pct_td\" style=\"background-color: #c7c7c7; width: 45%; text-align: center;\">Model Number</td>\n<td class=\"pct_td\">PC4-M6</td>\n</tr>\n<tr class=\"pct_tr\">\n<td class=\"pct_td\" style=\"background-color: #c7c7c7; width: 45%; text-align: center;\">Usage</td>\n<td class=\"pct_td\">For 4mm PTFE Tube</td>\n</tr>\n</tbody>\n</table>\n</div>\n</div>\n</div>\n<!-- table布局 --></div>\n<!-- 第二条 -->\n<div class=\"pct_ic-p\">\n<div class=\"pct_ic\"><!-- table布局 -->\n<div class=\"pct pct_mc\">\n<div class=\"pct_st-tbc\" style=\"padding: 0;\">\n<div class=\"pct_tbc\">\n<table class=\"pct_tb\" style=\"width: 100%; margin-top: 0; font-weight: bold;\"><!-- 表头 -->\n<tbody>\n<tr class=\"pct_tr\">\n<td class=\"pct_td\" style=\"background-color: #c7c7c7; width: 45%; text-align: center;\">Main Body Material</td>\n<td class=\"pct_td\">H59 Brass</td>\n</tr>\n<tr class=\"pct_tr\">\n<td class=\"pct_td\" style=\"background-color: #c7c7c7; width: 45%; text-align: center;\">Color</td>\n<td class=\"pct_td\">Silver</td>\n</tr>\n</tbody>\n</table>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n<!-- 如需添加在此处添加 --></div>\n<!-- 标题加文案结束 --> <!-- 查看PDF --></div>\n</div>\n</div>\n<div class=\"pct pct_mc\">\n<div class=\"pct_padding-in-mobile\">\n<h2 class=\"pct_t\"></h2>\n<h2 class=\"pct_st\"></h2>\n<h2 class=\"pct_t\">Introduction</h2>\n<h2 class=\"pct_st\"></h2>\n<p style=\"text-align: left;\">This fitting is perfect for connecting both PTFE (Teflon) tubes, ensuring smooth and consistent flow during your DIY projects.</p>\n</div>\n</div>\n<div class=\"pct pct_mc\">\n<div class=\"pct_padding-in-mobile\">\n<h2 class=\"pct_t\"></h2>\n<h2 class=\"pct_st\"></h2>\n<h2 class=\"pct_t\">Considerations</h2>\n<h2 class=\"pct_st\"></h2>\n<ul>\n<li>\n<p>Verify that the fitting size matches the diameters of your PTFE (Teflon) tubes to ensure a proper fit.</p>\n</li>\n<li>\n<p>Ensure that the tubes are securely inserted into the fitting to prevent any disconnection or leaks.</p>\n</li>\n<li>\n<p>Regularly inspect the fitting and connected tubes for any signs of wear or damage, and replace them as necessary to maintain optimal performance.</p>\n</li>\n</ul>\n</div>\n</div>\n</div>",
  "description_text": "This fitting is perfect for connecting both PTFE (Teflon) tubes, ensuring smooth and consistent flow during your DIY projects.\n\nVerify that the fitting size matches the diameters of your PTFE (Teflon) tubes to ensure a proper fit.\n\nEnsure that the tubes are securely inserted into the fitting to prevent any disconnection or leaks.\n\nRegularly inspect the fitting and connected tubes for any signs of wear or damage, and replace them as necessary to maintain optimal performance.",
