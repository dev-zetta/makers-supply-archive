\"]},\"nextNum\":1}},\"type\":\"text\",\"referenceRecordMap\":{},\"extra\":{\"mention_page_title\":{},\"external_mention_url\":{}},\"isKeepQuoteContainer\":false,\"isFromCode\":false,\"selection\":[{\"id\":64,\"type\":\"text\",\"selection\":{\"start\":0,\"end\":6},\"recordId\":\"WN9wdvxjroLLKUxZrwrcWzjZnhd\"}],\"payloadMap\":{},\"isCut\":false}' data-lark-record-format=\"docx/text\"></span></td>\n<td class=\"pct_td\" style=\"height: 19px; width: 48.6285px;\">1</td>\n</tr>\n<tr class=\"pct_tr\" style=\"height: 19px;\">\n<td class=\"pct_td\" style=\"height: 19px; width: 483.42px;\">\n<div>\n<div data-line=\"true\" data-line-index=\"0\" data-zone-id=\"0\">\n<p>D2 Stainless Steel Dowel Pin 2x25mm - DA002</p>\n</div>\n</div>\n<span class=\"lark-record-clipboard\" data-lark-record-data='{\"rootId\":\"OKsfdVZTpoQRnExo2lIcyoskncC\",\"text\":{\"initialAttributedTexts\":{\"text\":{\"0\":\"Button\"},\"attribs\":{\"0\":\"*0+6\"}},\"apool\":{\"numToAttrib\":{\"0\":[\"author\",\"7118919285765865474\"]},\"nextNum\":1}},\"type\":\"text\",\"referenceRecordMap\":{},\"extra\":{\"mention_page_title\":{},\"external_mention_url\":{}},\"isKeepQuoteContainer\":false,\"isFromCode\":false,\"selection\":[{\"id\":64,\"type\":\"text\",\"selection\":{\"start\":0,\"end\":6},\"recordId\":\"WN9wdvxjroLLKUxZrwrcWzjZnhd\"}],\"payloadMap\":{},\"isCut\":false}' data-lark-record-format=\"docx/text\"></span></td>\n<td class=\"pct_td\" style=\"height: 19px; width: 48.6285px;\">1</td>\n</tr>\n<tr class=\"pct_tr\" style=\"height: 19px;\">\n<td class=\"pct_td\" style=\"height: 19px; width: 483.42px;\">\n<div>\n<div data-line=\"true\" data-line-index=\"0\" data-zone-id=\"0\">\n<p>M2x8 FHCS Machine Screw - AA179</p>\n</div>\n</div>\n<span class=\"lark-record-clipboard\" data-lark-record-data='{\"rootId\":\"OKsfdVZTpoQRnExo2lIcyoskncC\",\"text\":{\"initialAttributedTexts\":{\"text\":{\"0\":\"Button\"},\"attribs\":{\"0\":\"*0+6\"}},\"apool\":{\"numToAttrib\":{\"0\":[\"author\",\"7118919285765865474\"]},\"nextNum\":1}},\"type\":\"text\",\"referenceRecordMap\":{},\"extra\":{\"mention_page_title\":{},\"external_mention_url\":{}},\"isKeepQuoteContainer\":false,\"isFromCode\":false,\"selection\":[{\"id\":64,\"type\":\"text\",\"selection\":{\"start\":0,\"end\":6},\"recordId\":\"WN9wdvxjroLLKUxZrwrcWzjZnhd\"}],\"payloadMap\":{},\"isCut\":false}' data-lark-record-format=\"docx/text\"></span></td>\n<td class=\"pct_td\" style=\"height: 19px; width: 48.6285px;\">1</td>\n</tr>\n</tbody>\n</table>\n<p></p>\n<p></p>\n<h3 class=\"pct_st\" style=\"text-align: left;\">Considerations</h3>\n<p></p>\n<div data-docx-has-block-data=\"false\" data-lark-html-role=\"root\" data-page-id=\"BraMdd9z6owwkNxjI3McPYx2nsb\">\n<ul class=\"list-bullet1\" start=\"1\">\n<li class=\"ace-line ace-line old-record-id-ODysdZlfCo9hDCxPyhscEAjsn7c\" data-list=\"bullet\">\n<div>After a while, your vehicle may have difficulty climbing the bridge. First wash the O-rings in warm soapy water. The O-rings are dust magnets and will need to be cleaned every now and again.</div>\n</li>\n<li class=\"ace-line ace-line old-record-id-W1sBdzyZVo6rQkxAUQ8cpPkVnGb\" data-list=\"bullet\">\n<div>Turning the lights off will help the batteries last longer.</div>\n</li>\n<li class=\"ace-line ace-line old-record-id-PBiSdYrpLoWurax3MnDcqvOTnMf\" data-list=\"bullet\">\n<div>If the wheels spin in the wrong direction, simply rotate the motor.</div>\n</li>\n<li class=\"ace-line ace-line old-record-id-J67QdeQgtooQQ3xKD0ucWPtmnjb\" data-list=\"bullet\">\n<div>Each kit contains all the parts you need to complete one car model.</div>\n</li>\n</ul>\n</div>\n<p></p>\n</div>\n</div>",
  "description_text": "After a while, your vehicle may have difficulty climbing the bridge. First wash the O-rings in warm soapy water. The O-rings are dust magnets and will need to be cleaned every now and again.\n\nTurning the lights off will help the batteries last longer.\n\nIf the wheels spin in the wrong direction, simply rotate the motor.\n\nEach kit contains all the parts you need to complete one car model.",
