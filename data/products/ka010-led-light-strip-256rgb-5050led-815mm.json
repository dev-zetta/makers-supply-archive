  "description_blocks": [
    {
      "kind": "heading",
      "text": "Instruction"
    },
    {
      "kind": "paragraph",
      "text": "This LED Light Strip features 5050 RGB LEDs, it has 256 light beads in a 815-mm length. This strip delivers vibrant, customizable lighting that is great for DIY electronics, home decor, and creative projects. It can be used with the Motion-Activated Sound and Light Props Kit-01 & 02 to create your unique model projects."
    },
    {
      "kind": "heading",
      "text": "Considerations"
    },
    {
      "kind": "bullet",
      "text": "If it is used with the Motion-Activated Sound and Light Props Kit-01 & 02， you need to adjust the number of control light beads to 128 in the APP."
    },
    {
      "kind": "bullet",
      "text": "Always disconnect the power supply before starting any installation to prevent electric shock or short circuits."
    },
    {
      "kind": "bullet",
      "text": "Ensure the input voltage matches the specified DC 3.7v-4.2v to prevent damage or reduced lifespan."
    },
    {
      "kind": "bullet",
      "text": "Do not exceed the recommended operating current to ensure optimal performance and product longevity."
    },
    {
      "kind": "bullet",
      "text": "Keep away from moisture and excessive heat sources."
    },
    {
      "kind": "bullet",
      "text": "Keep out of reach of children. This product is not a toy and should be handled responsibly."
    }
  ],
  "description_html": "<div class=\"pct pct_mc\">\n<h2 class=\"pct_t\"></h2>\n</div>\n<div class=\"pct pct_mc\">\n<div class=\"pct_st-tbc\">\n<div class=\"pct_tbc\">\n<div class=\"pct pct_mc\">\n<div class=\"pct_padding-in-mobile\">\n<h2 class=\"pct_t\" style=\"text-align: left;\">Instruction</h2>\n<h2 class=\"pct_st\"></h2>\n<div data-docx-has-block-data=\"false\" data-lark-html-role=\"root\" data-page-id=\"BraMdd9z6owwkNxjI3McPYx2nsb\">\n<div class=\"old-record-id-FaACdSbwHo7BVoxUPdKcnkF5nce\">This LED Light Strip features 5050 RGB LEDs, it has 256 light beads in a 815-mm length. This strip delivers vibrant, customizable lighting that is great for DIY electronics, home decor, and creative projects. <br/>It can be used with the <span style=\"color: #2dc26b;\"><a href=\"https://us.store.bambulab.com/products/motion-activated-sound-and-light-props-kit\" rel=\"noopener\" style=\"color: #2dc26b;\" target=\"_blank\"><span style=\"color: #00ae42;\">Motion-Activated Sound and Light Props Kit-01 &amp; 02</span></a></span> to create your unique model projects.</div>\n</div>\n<p> </p>\n</div>\n</div>\n<table class=\"pct_tb\" style=\"border-color: #adadad; font-weight: bold; height: 120px; width: 111.864%;\"><!-- 物品清单布局 --><!-- 标题加文案结æ�?--> <!-- 表头 -->\n<thead class=\"pct_th\">\n<tr style=\"height: 40px;\">\n<td class=\"pct_td\" style=\"background-color: #c7c7c7; color: #333333; border-color: #adadad; font-weight: bold; text-align: center; height: 40px; width: 13.6939%; padding: 10px !important;\">\n<div>Product ID</div>\n</td>\n<td class=\"pct_td\" style=\"background-color: #c7c7c7; color: #333333; border-color: #adadad; font-weight: bold; height: 40px; width: 16.6547%; padding: 10px !important;\">\n<div>LED Model </div>\n</td>\n<td class=\"pct_td\" style=\"background-color: #c7c7c7; color: #333333; border-color: #adadad; font-weight: bold; height: 40px; width: 12.5836%; padding: 10px !important;\"> Light Bead Quantity</td>\n<td class=\"pct_td\" style=\"background-color: #c7