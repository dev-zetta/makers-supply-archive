  "description_blocks": [
    {
      "kind": "heading",
      "text": "Instruction"
    },
    {
      "kind": "paragraph",
      "text": "The DC5521 Female to 2-Pin Solderless Quick Connector offers a simple and efficient power solution for the White CCT Tunable COB LED Strip Light. Designed for convenience, it features a solder-free connector on one end for effortless attachment to the LED strip, and a DC plug on the other end for seamless connection to a 24V AC-to-DC power adapter. This connector makes completing your illuminated DIY projects easier and more efficient than ever."
    },
    {
      "kind": "heading",
      "text": "Consideration"
    },
    {
      "kind": "bullet",
      "text": "Always disconnect power before installation."
    },
    {
      "kind": "bullet",
      "text": "Do not connect to power adapters exceeding 24V to prevent potential damage or safety risks."
    },
    {
      "kind": "bullet",
      "text": "Keep out of reach of children. This product is not a toy and should be handled responsibly."
    }
  ],
  "description_html": "<div class=\"pct pct_mc\">\n<h2 class=\"pct_t\"><br/></h2>\n<br/>\n</div>\n<div class=\"pct pct_mc\">\n<div class=\"pct_st-tbc\">\n<div class=\"pct_tbc\">\n<div class=\"pct pct_mc\">\n<div class=\"pct_padding-in-mobile\">\n<h2 class=\"pct_t\" style=\"text-align: left;\">Instruction</h2>\n<h2 class=\"pct_st\"><br/></h2>\n<div data-docx-has-block-data=\"false\" data-lark-html-role=\"root\" data-page-id=\"BraMdd9z6owwkNxjI3McPYx2nsb\">\n<div class=\"old-record-id-FaACdSbwHo7BVoxUPdKcnkF5nce\">The DC5521 Female to 2-Pin Solderless Quick Connector offers a simple and efficient power solution for the <span style=\"color: rgb(0, 174, 66);\"><a href=\"https://us.store.bambulab.com/products/white-cct-tunable-cob-led-strip-light?id=41623262199923\" style=\"color: rgb(0, 174, 66);\" target=\"_blank\">White CCT Tunable COB LED Strip Light</a></span>. Designed for convenience, it features a solder-free connector on one end for effortless attachment to the LED strip, and a DC plug on the other end for seamless connection to a <span style=\"color: rgb(0, 174, 66);\"><a href=\"https://us.store.bambulab.com/products/ac-dc-power-adapter?id=550238627006992391&amp;skr=yes\" style=\"color: rgb(0, 174, 66);\" target=\"_blank\">24V AC-to-DC power adapter</a></span>. This connector makes completing your illuminated DIY projects easier and more efficient than ever.</div>\n</div>\n<p> </p>\n</div>\n</div>\n<table class=\"pct_tb\" style=\"border-color: rgb(173, 173, 173); font-weight: bold; height: 120px; width: 111.864%;\">\n<!-- 物品清单布局 --><!-- 标题加文案结束 --> <!-- 表头 -->\n<thead class=\"pct_th\">\n<tr style=\"height: 40px;\">\n<td class=\"pct_td\" style=\"background-color: rgb(199, 199, 199); color: rgb(51, 51, 51); border-color: rgb(173, 173, 173); font-weight: bold; text-align: center; height: 40px; width: 13.6939%; padding: 10px !important;\">\n<div>Product ID</div>\n</td>\n<td class=\"pct_td\" style=\"background-color: rgb(199, 199, 199); color: rgb(51, 51, 51); border-color: rgb(173, 173, 173); font-weight: bold; height: 40px; width: 16.6547%; padding: 10px !important;\">\n<div>Connector Model</div>\n</td>\n<td class=\"pct_td\" style=\"background-color: rgb(199, 199, 199); color: rgb(51, 51, 51); border-color: rgb(173, 173, 173); font-weight: bold; height: 40px; width: 12.5836%; padding: 10px !important;\">DC Plug<br/>(mm)</td>\n<td class=\"pct_td\" style=\"background-color: rgb(199, 199, 199); color: rgb(51, 51, 51); border-color: rgb(173, 173, 173); font-weight: bold; height: 40px; width: 13.1387%; padding: 10px !important;\">Length<br/>(mm)</td>\n<td class=\"pct_td\" style=\"background-color: rgb(199, 199, 199); color: rgb(51, 51, 51); border-color: rgb(173, 173, 173); font-weight: bold; height: 40px; width: 15.1743%; padding: 10px !important;\">Input Voltage<br/>（Volts）</td>\n<td class=\"pct_td\" style=\"background-color: rgb(199, 199, 199); color: rgb(51, 51, 51); border-color: rgb(173, 173, 173); font-weight: bold; height: 40px; width: 18.1101%; padding: 10px !important;\">Outer Diameter<br/>(mm)</td>\n<td class=\"pct_td\" style=\"background-color: rgb(199, 199, 199); color: rgb(51, 51, 51); border-color: rgb(173, 173, 173); font-weight: bold; height: 40px; width: 8.90757%; padding: 10px !important;\">Wire Gauge Size</td>\n</tr>\n</thead>\n<tbody>\n<tr class=\"pct_tr\" style=\"height: 15px;\">\n<td class=\"pct_td\" style=\"border-color: rgb(173, 173, 173); text-align: center; height: 15px; width: 13.6939%; padding: 10px !important;\">\n<meta charset=\"utf-8\"/>\n<div data-docx-has-block-data=\"true\" data-lark-html-role=\"root\" data-page-id=\"OsAldE1cUoGAUQxg1D4cwL9Xnqc\">XC008</div>\n<span class=\"lark-record-clipboard\" data-lark-record-data='{\"isCut\":false,\"rootId\":\"OsAldE1cUoGAUQxg1D4cwL9Xnqc\",\"parentId\":\"Jv7edlcdSoYT8oxfY2acfhh8nMd\",\"blockIds\":[24],\"recordIds\":[\"Jv7edlcdSoYT8oxfY2acfhh8nMd\"],\"recordMap\":{\"HIMvdTUHFosGN7xpx5Mc7Lpgn6c\":{\"id\":\"HIMvdTUHFosGN7xpx5Mc7Lpgn6c\",\"snapshot\":{\"type\":