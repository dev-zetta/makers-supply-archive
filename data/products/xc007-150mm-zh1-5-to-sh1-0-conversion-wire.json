ded\":false}},\"QvGSdWjUpoqoAPxFrYAc3mQAnPg\":{\"id\":\"QvGSdWjUpoqoAPxFrYAc3mQAnPg\",\"snapshot\":{\"type\":\"table_cell\",\"parent_id\":\"Jv7edlcdSoYT8oxfY2acfhh8nMd\",\"comments\":[],\"revisions\":[],\"locked\":false,\"hidden\":false,\"author\":\"7436941571142926338\",\"children\":[\"E2TsdMkJuoukcexwn4Uckptnnqf\"]}}},\"payloadMap\":{\"E2TsdMkJuoukcexwn4Uckptnnqf\":{\"level\":1}},\"extra\":{\"channel\":\"saas\",\"pasteRandomId\":\"7063923b-b852-4ff4-b2c2-721894e94b0a\",\"mention_page_title\":{},\"external_mention_url\":{}},\"isKeepQuoteContainer\":false,\"selection\":[{\"id\":56,\"type\":\"block\",\"recordId\":\"E2TsdMkJuoukcexwn4Uckptnnqf\"}],\"pasteFlag\":\"72557e45-58df-453a-9aa8-adb004c90403\"}' data-lark-record-format=\"docx/record\"></span>\n</td>\n<td class=\"pct_td\" data-mce-style=\"border-color: #adadad; padding: 10px !important; height: 15px; width: 159.023px;\" style=\"border-color: #adadad; padding: 10px !important; height: 15px; width: 159.023px;\">150</td>\n<td class=\"pct_td\" data-mce-style=\"border-color: #adadad; padding: 10px !important; height: 15px; width: 159.023px;\" style=\"border-color: #adadad; padding: 10px !important; height: 15px; width: 159.023px;\">0.9</td>\n<td class=\"pct_td\" data-mce-style=\"border-color: #adadad; padding: 10px !important; height: 15px; width: 159.023px;\" style=\"border-color: #adadad; padding: 10px !important; height: 15px; width: 159.023px;\">28AWG</td>\n<td class=\"pct_td\" data-mce-style=\"border-color: #adadad; padding: 10px !important; height: 15px; width: 159.023px;\" style=\"border-color: #adadad; padding: 10px !important; height: 15px; width: 159.023px;\">Red/Black</td>\n</tr>\n</tbody>\n</table>\n</div>\n</div>\n</div>\n<div class=\"pct pct_mc\">\n<div class=\"pct_padding-in-mobile\">\n<h2 class=\"pct_t\"><br/></h2>\n<h2 class=\"pct_st\"><br/></h2>\n<h2 class=\"pct_t\" style=\"text-align: left;\">Consideration</h2>\n<p> </p>\n<ul>\n<li>Please pay attention to the connector markings on the PCB and plug the appliance into the CN-MOTO connector.</li>\n<li>Please hold the connector when plugging and unplugging, and do not forcefully twist the connectors to avoid wires loosening or detaching</li>\n</ul>\n</div>\n</div>",
  "description_text": "150mm ZH1.5 to SH1.0 conversion cable for the Rechargeable Power Supply Kit - ZC003, allowing the connection of COB LED Strip Light - KA007, N20 Dual Shaft Worm Gear Motor - LA009 and many more appliances.\n\nPlease pay attention to the connector markings on the PCB and plug the appliance into the CN-MOTO connector.\n\nPlease hold the connector when plugging and unplugging, and do not forcefully twist the connectors to avoid wires loosening or detaching",
