x solid #cccccc; padding: 10px;\">1/4\" Camera Quick Release Plate Nut (2PCS) - FC010</td>\n<td class=\"pct_td\" style=\"border: 1px solid #cccccc; padding: 10px;\">1</td>\n</tr>\n<tr class=\"pct_tr\"><!-- Box模块 -->\n<td class=\"pct_td\" style=\"border: 1px solid #cccccc; padding: 10px;\">9</td>\n<td class=\"pct_td\" style=\"border: 1px solid #cccccc; padding: 10px;\">1/4 Aluminium Alloy Screw (3PCS) - FC011</td>\n<td class=\"pct_td\" style=\"border: 1px solid #cccccc; padding: 10px;\">1</td>\n</tr>\n<tr class=\"pct_tr\"><!-- Box模块 -->\n<td class=\"pct_td\" style=\"border: 1px solid #cccccc; padding: 10px;\">10</td>\n<td class=\"pct_td\" style=\"border: 1px solid #cccccc; padding: 10px;\">1/4\" - 12x15 Camera screw (3PCS) - FC014</td>\n<td class=\"pct_td\" style=\"border: 1px solid #cccccc; padding: 10px;\">1</td>\n</tr>\n<tr class=\"pct_tr\"><!-- Box模块 -->\n<td class=\"pct_td\" style=\"border: 1px solid #cccccc; padding: 10px;\">11</td>\n<td class=\"pct_td\" style=\"border: 1px solid #cccccc; padding: 10px;\">L Type H2.5 Hex Wrench (2PCS) - QA006</td>\n<td class=\"pct_td\" style=\"border: 1px solid #cccccc; padding: 10px;\">1</td>\n</tr>\n<tr class=\"pct_tr\"><!-- Box模块 -->\n<td class=\"pct_td\" style=\"border: 1px solid #cccccc; padding: 10px;\">12</td>\n<td class=\"pct_td\" style=\"border: 1px solid #cccccc; padding: 10px;\">L Type H4 Hex Wrench (2pcs) - QA007</td>\n<td class=\"pct_td\" style=\"border: 1px solid #cccccc; padding: 10px;\">1</td>\n</tr>\n<tr class=\"pct_tr\"><!-- Box模块 -->\n<td class=\"pct_td\" style=\"border: 1px solid #cccccc; padding: 10px;\">13</td>\n<td class=\"pct_td\" style=\"border: 1px solid #cccccc; padding: 10px;\">Adjustable Hand Wrist Strap - Black (1PCS) - MF003</td>\n<td class=\"pct_td\" style=\"border: 1px solid #cccccc; padding: 10px;\">1</td>\n</tr>\n<!-- Box模块  结尾--></tbody>\n</table>\n</div>\n</div>\n</div>",
  "description_text": "MOCA Mobile Phone Cage Kit is a modular filming kit designed for efficient content creation. Featuring a NATO rail system and 1/4\" standard mounts, it supports quick attachment of accessories like LED lights and microphones. Adaptable for handheld, vertical, and tripod shooting modes. Customizable via 3D printing with color options and pro-grade materials for both daily use and demanding outdoor scenarios.\n\nAnti-Shake Ergonomic Grip: Textured rubber handles with 15° angled design reduce wrist fatigue and minimize shake during handheld filming.\n\nTool-Free NATO Rail System: Dual-side quick-release rails (1/4\" mounts) hold accessories like LED panels (≤500g) without screws – swap in 3 seconds.\n\n360° Multi-Scene Adapter 360°: Rotatable clamp supports vertical shooting, tripod mounting, and overhead angles with a 90° locking mechanism.\n\nWhat phones are compatible? This kit is compatible with devices 60–90mm in width (e.g., iPhone 15 Pro Max/Samsung S24 Ultra).\n\nWhat phones are compatible?\n\nThis kit is compatible with devices 60–90mm in width (e.g., iPhone 15 Pro Max/Samsung S24 Ultra).\n\nHow to maintain and clean the kit? Wipe rails and mounts with a dry cloth weekly to prevent dust buildup. For stains, use a cotton swab dipped in alcohol. Do not immerse in water.\n\nHow to maintain and clean the kit?\n\nWipe rails and mounts with a dry cloth weekly to prevent dust buildup. For stains, use a cotton swab dipped in alcohol. Do not immerse in water.\n\nAre third-party accessories supported? Compatible with all 1/4\" standard accessories (tripods, LED lights, mics). Non-standard accessories require stability testing.\n\nAre third-party accessories supported?\n\nCompatible with all 1/4\" standard accessories (tripods, LED lights, mics). Non-standard accessories require stability testing.",
