  "description_blocks": [
    {
      "kind": "heading",
      "text": "Introduction"
    },
    {
      "kind": "paragraph",
      "text": "The AC to DC Power Adapter universally supports devices requires 12V or 24V with a power output of up to 2A. It includes four interchangeable AC connectors, making it compatible with power outlets in North America, Europe, the United Kingdom, and Australia. This power supply is a good replacement for a lost or damaged power adapter. Having a spare one in hand will ensure that you always have a power source."
    },
    {
      "kind": "heading",
      "text": "Applications"
    },
    {
      "kind": "bullet",
      "text": "The 12V 2A adapter is suitable for the Magnetic Levitation DIY Kit."
    },
    {
      "kind": "bullet",
      "text": "Supports any device that requires 12V or 24V with a power output of up to 2A."
    },
    {
      "kind": "heading",
      "text": "Consideration"
    },
    {
      "kind": "paragraph",
      "text": "The adapter's maximum output of 2A ensures it can supply up to, but not exceeding, 2A. For example, if your device requires 1.5A, it will receive 1.5A. However, if your device demands more than 2A, the adapter will be limited to supplying only 2A, which may not be sufficient for your device's needs."
    }
  ],
  "description_html": "<div class=\"pct pct_mc\">\n<div class=\"pct_tpc-ic\">\n<div class=\"pct_ic\"> \n<h2 class=\"pct_t\" style=\"text-align: left;\">Introduction</h2>\n<p style=\"text-align: left;\"> </p>\n<p style=\"text-align: left;\">The AC to DC Power Adapter universally supports devices requires 12V or 24V with a power output of up to 2A. It includes four interchangeable AC connectors, making it compatible with power outlets in North America, Europe, the United Kingdom, and Australia. This power supply is a good replacement for a lost or damaged power adapter. Having a spare one in hand will ensure that you always have a power source.</p>\n<p style=\"text-align: left;\"> </p>\n<p><img alt=\"\" class=\"product-desc-lazy-media product-desc-lazy-media--image bg-bbl-white animate-pulse aspect-video max-h-[400px]\" data-lazy=\"false\" data-src=\"https://store.bblcdn.com/s7/default/abb47f70648b465fb6311a0c85fcabc9/Compact_Multi-Use_Case_in_two_sizes.jpg\" src=\"data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjQiIGhlaWdodD0iMjQiIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj4KPHJlY3Qgd2lkdGg9IjI0IiBoZWlnaHQ9IjI0IiBmaWxsPSIjRkZGRkZGIi8+Cjwvc3ZnPgo=\"/></p>\n</div>\n</div>\n</div>\n<div class=\"pct pct_mc\">\n<div class=\"pct pct_mc\">\n<div class=\"pct_st-tbc product-specification-table-small-padding\">\n<p><img alt=\"\" class=\"product-desc-lazy-media product-desc-lazy-media--image bg-bbl-white animate-pulse aspect-video max-h-[400px]\" data-lazy=\"false\" data-src=\"https://store.bblcdn.com/s7/default/983f42ab6984426aa3e6789442b3ac11/banner2.jpg\" src=\"data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjQiIGhlaWdodD0iMjQiIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj4KPHJlY3Qgd2lkdGg9IjI0IiBoZWlnaHQ9IjI0IiBmaWxsPSIjRkZGRkZGIi8+Cjwvc3ZnPgo=\"/></p>\n<div class=\"pct_tbc\">\n<table class=\"pct_tb\" style=\"border-color: #adadad; font-weight: bold; width: 90.3285%;\"><!-- 表头 -->\n<thead class=