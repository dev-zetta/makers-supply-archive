extNum\":1}},\"type\":\"text\",\"referenceRecordMap\":{},\"extra\":{\"channel\":\"saas\",\"pasteRandomId\":\"e75fd37b-4b9c-4a3d-ba63-3a6f6feb497d\",\"mention_page_title\":{},\"external_mention_url\":{}},\"isKeepQuoteContainer\":false,\"isFromCode\":false,\"selection\":[{\"id\":2367,\"type\":\"text\",\"selection\":{\"start\":0,\"end\":6},\"recordId\":\"RJTpdV06aowORRx5LYXc5Szrn3c\"}],\"payloadMap\":{},\"isCut\":false}' data-lark-record-format=\"docx/text\"></span></td>\n<td class=\"pct_td\" style=\"border-color: #adadad; width: 15.3374%;\">\n<div data-docx-has-block-data=\"false\" data-lark-html-role=\"root\" data-page-id=\"BraMdd9z6owwkNxjI3McPYx2nsb\">\n<div class=\"ace-line ace-line old-record-id-Zws4djsdEoTlgMxASIychh5dnke\">2A</div>\n</div>\n<span class=\"lark-record-clipboard\" data-lark-record-data='{\"rootId\":\"BraMdd9z6owwkNxjI3McPYx2nsb\",\"text\":{\"initialAttributedTexts\":{\"text\":{\"0\":\"2A\"},\"attribs\":{\"0\":\"*0+2\"}},\"apool\":{\"numToAttrib\":{\"0\":[\"author\",\"7436941571142926338\"]},\"nextNum\":1}},\"type\":\"text\",\"referenceRecordMap\":{},\"extra\":{\"channel\":\"saas\",\"pasteRandomId\":\"8c237750-4b4d-4a90-a6f8-7f5d52ae0dd1\",\"mention_page_title\":{},\"external_mention_url\":{}},\"isKeepQuoteContainer\":false,\"isFromCode\":false,\"selection\":[{\"id\":2334,\"type\":\"text\",\"selection\":{\"start\":0,\"end\":2},\"recordId\":\"Zws4djsdEoTlgMxASIychh5dnke\"}],\"payloadMap\":{},\"isCut\":false}' data-lark-record-format=\"docx/text\"></span></td>\n<td class=\"pct_td\" style=\"border-color: #adadad; width: 12.6789%;\">100-240V 50/60Hz</td>\n<td class=\"pct_td\" style=\"border-color: #adadad; width: 12.0654%;\">1.2m</td>\n</tr>\n</tbody>\n<tbody></tbody>\n</table>\n</div>\n</div>\n</div>\n</div>\n<div class=\"pct pct_mc\">\n<div class=\"pct_st-tbc\">\n<div class=\"pct_tbc\">\n<h2 class=\"pct_t\" style=\"text-align: left;\"></h2>\n<h2 class=\"pct_t\" style=\"text-align: left;\">Applications</h2>\n<div data-docx-has-block-data=\"false\" data-lark-html-role=\"root\" data-page-id=\"BraMdd9z6owwkNxjI3McPYx2nsb\">\n<ul>\n<li data-list=\"bullet\">\n<div>The 12V 2A adapter is suitable for the <a data-lark-is-custom=\"true\" href=\"https://us.store.bambulab.com/products/magnetic-levitation-diy-kit\" rel=\"noopener\" target=\"_blank\"><span style=\"color: #2dc26b;\">Magnetic Levitation DIY Kit</span></a>.</div>\n</li>\n</ul>\n</div>\n<ul>\n<li style=\"text-align: left;\">Supports any device that requires 12V or 24V with a power output of up to 2A.</li>\n</ul>\n<p style=\"text-align: left;\">  </p>\n<h2 class=\"pct_t\" style=\"text-align: left;\">Consideration</h2>\n<div data-docx-has-block-data=\"false\" data-lark-html-role=\"root\" data-page-id=\"BraMdd9z6owwkNxjI3McPYx2nsb\">The adapter's maximum output of 2A ensures it can supply up to, but not exceeding, 2A. For example, if your device requires 1.5A, it will receive 1.5A. However, if your device demands more than 2A, the adapter will be limited to supplying only 2A, which may not be sufficient for your device's needs.</div>\n<div data-docx-has-block-data=\"false\" data-lark-html-role=\"root\" data-page-id=\"BraMdd9z6owwkNxjI3McPYx2nsb\"></div>\n<div data-docx-has-block-data=\"false\" data-lark-html-role=\"root\" data-page-id=\"BraMdd9z6owwkNxjI3McPYx2nsb\"></div>\n<div data-docx-has-block-data=\"false\" data-lark-html-role=\"root\" data-page-id=\"BraMdd9z6owwkNxjI3McPYx2nsb\">\n<h2 class=\"pct_st\" style=\"text-align: center;\">In the Box</h2>\n<div class=\"pct pct_mc\">\n<div class=\"pct_st-tbc\">\n<div class=\"pct_tbc\">\n<table class=\"pct_tb\" style=\"height: 200px; width: 100%; text-align: center; border-collapse: collapse;\"><!-- 表头 -->\n<thead class=\"pct_th\">\n<tr style=\"background-color: #333333; color: white;\">\n<td class=\"pct_td\" style=\"border: 1px solid #333333; padding: 10px; width: 19.9269%;\"><strong>Item Number</strong></td>\n<td class=\"pct_td\" style=\"border: 1px solid #333333; padding: 10px; width: 59.9634%;\"><strong>Item Name</strong></td>\n<td class=\"pct_td\" style=\"border: 1px solid #333333; padding: 10px; width: 19.9269%;\"><strong>Quantity</strong></td>\n</tr>\n</thead>\n<tbody>\n<tr class=\"pct_tr\">\n<td class=\"pct_td\" style=\"border: 1px solid #cccccc; padding: 10px; width: 19.9269%;\">1</td>\n<td class=\"pct_td\" style=\"border: 1px solid #cccccc; padding: 10px; width: 59.9634%;\">AC to DC Power Adapter</td>\n<td class=\"pct_td\" style=\"border: 1px solid #cccccc; padding: 10px; width: 19.9269%;\">1</td>\n</tr>\n<tr class=\"pct_tr\">\n<td class=\"pct_td\" style=\"border: 1px solid #cccccc; padding: 10px; width: 19.9269%;\">2</td>\n<td class=\"pct_td\" style=\"border: 1px solid #cccccc; padding: 10px; width: 59.9634%;\">Universal Replacement AC Connector (CN, NA, EU, UK, AU)</td>\n<td class=\"pct_td\" style=\"border: 1px solid #cccccc; padding: 10px; width: 19.9269%;\">5</td>\n</tr>\n</tbody>\n</table>\n<h2 class=\"pct_t\" style=\"text-align: left;\"></h2>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>",
  "description_text": "The AC to DC Power Adapter universally supports devices requires 12V or 24V with a power output of up to 2A. It includes four interchangeable AC connectors, making it compatible with power outlets in North America, Europe, the United Kingdom, and Australia. This power supply is a good replacement for a lost or damaged power adapter. Having a spare one in hand will ensure that you always have a power source.\n\nThe 12V 2A adapter is suitable for the Magnetic Levitation DIY Kit.\n\nSupports any device that requires 12V or 24V with a power output of up to 2A.\n\nThe adapter's maximum output of 2A ensures it can supply up to, but not exceeding, 2A. For example, if your device requires 1.5A, it will receive 1.5A. However, if your device demands more than 2A, the adapter will be limited to supplying only 2A, which may not be sufficient for your device's needs.",
