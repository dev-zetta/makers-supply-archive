  "description_blocks": [
    {
      "kind": "heading",
      "text": "Overview"
    },
    {
      "kind": "paragraph",
      "text": "This bike saddle rail is specifically designed for 3D-printed saddles, crafted from high-strength Chromoly Steel with a durable rust-resistant coating that withstands rainy rides. Its streamlined design enables tool-free installation, balancing structural integrity and practicality to meet daily commuting and casual cycling needs effortlessly."
    },
    {
      "kind": "heading",
      "text": "Product Feature"
    },
    {
      "kind": "bullet",
      "text": "High-Strength Chromoly Steel: Durable and bend-resistant construction built for challenging terrains."
    },
    {
      "kind": "bullet",
      "text": "Universal Tool-Free Installation: Seamlessly fits 3D-printed and traditional saddles with a secure clamping system."
    },
    {
      "kind": "bullet",
      "text": "All-Weather Corrosion Defense: Electroplated coating resists rain, sweat, and abrasion for urban or off-road use."
    }
  ],
  "description_html": "<div class=\"pct pct_mc\">\n<h2 class=\"pct_st\"></h2>\n<h2 class=\"pct_st\"></h2>\n<h2 class=\"pct_t\">Documentation</h2>\n<h2 class=\"pct_st\"></h2>\n<p class=\"pct_padding-in-mobile pct_downloadContent\" style=\"text-align: center; gap: 40px; display: flex; justify-content: center;\"><!-- 3D Model --><a href=\"https://cdn.shopify.com/s/files/1/0645/5876/0155/files/Bike_Saddle_Rail_-_FC013.zip?v=1742971596\" rel=\"noopener\" style=\"color: #333333; font-weight: 600; display: flex; justify-content: center; align-items: center; gap: 20px;\" target=\"_blank\"> <img alt=\"3D\" class=\"download_svg product-desc-lazy-media product-desc-lazy-media--image bg-bbl-white animate-pulse max-h-[400px]\" data-lazy=\"false\" data-src=\"https://cdn.shopify.com/s/files/1/0611/4036/9460/files/3d.svg?v=1715161943\" src=\"data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjQiIGhlaWdodD0iMjQiIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj4KPHJlY3Qgd2lkdGg9IjI0IiBoZWlnaHQ9IjI0IiBmaWxsPSIjRkZGRkZGIi8+Cjwvc3ZnPgo=\"/> <span>3D Model</span> </a></p>\n<div class=\"pct pct_mc\">\n<div class=\"pct_ic\">\n<div class=\"pct pct_mc\">\n<div class=\"pct_tpc-ic\">\n<div class=\"pct_t-p\">\n<h2 class=\"pct_t\" style=\"margin-top: 40px; font-size: 24px;\">Overview</h2>\n<p class=\"pct_p\" style=\"text-align: left;\">This bike saddle rail is specifically designed for 3D-printed saddles, crafted from high-strength Chromoly Steel with a durable rust-resistant coating that withstands rainy rides. Its streamlined design enables tool-free installation, balancing structural integrity and practicality to meet daily commuting and casual cycling needs effortlessly.</p>\n</div>\n</div>\n<div class=\"pct pct_mc\">\n<div class=\"pct_st-tbc\">\n<div class=\"pct_tbc\">\n<table class=\"pct_tb\" style=\"width: 100%;\"><!-- 表头 -->\n<thead class=\"pct_th\">\n<tr style=\"height: 27px;\">\n<td class=\"pct_td\" style=\"width: 16.8028%; height: 27px; text-align: center;\"><strong>Models</strong></td>\n<td class=\"pct_td\" style=\"width: 19.7959%; height: 27px;\"><strong>Creators</strong></td>\n<td class=\"pct_td\" style=\"width: 25.0455%; height: 27px;\"><strong>Model Links</strong></td>\n<td class=\"pct_td\" style=\"width: 23.7801%; height: 27px;\"><strong>Need Other Accessories</strong></td>\n</tr>\n</thead>\n<tbody>\n<tr class=\"pct_tr\">\n<td class=\"pct_td\" style=\"width: 16.8028%; height: 25px; text-align: center;\"><strong>Bicycle Saddle</strong></td>\n<td class=\"pct_td\" style=\"width: 19.7959%; height: 25px;\"><strong>@Makerworld</strong></td>\n<td class=\"pct_td\" style=\"width: 25.0455%; height: 25px;\"><span style=\"color: #00ae42;\"><a href=\"https://makerworld.com/en/models/1246918-bicycle-saddle\" rel=\"noopener\" style=\"color: #00ae42;\" target=\"_blank\"><strong>Bicycle Saddle</strong></a></span></td>\n<td class=\"pct_td\" style=\"width: 23.7801%; height: 25px;\"><span style=\"color: #00ae42;\"><a href=\"https://makerworld.com/en/models/1246918-bicycle-saddle\" rel=\"noopener\" style=\"color: #00ae42;\" target=\"_blank\"><strong>YES</strong></a></span></td>\n</tr>\n</tbody>\n</table>\n</div>\n</div>\n</div>\n<!-- 表格对齐样式 -->\n<style>\n    .pct_hardware-tableList-t-icpc {\n        padding: '0 20px'\n    }\n\n    .pct_hardware-tableList {\n        width: 100%;\n        row-gap: 15px !important;\n        column-gap: 15px !important;\n    }\n\n    .pct_hardware-tableList .pct_ic-p {\n        overflow: hidden;\n    }\n\n    .pct_hardware-tableList .pct_st-tbc .pct_tb .pct_td {\n        border-color: #ADADAD;\n    }\n\n    @media (min-width: 640px) {\n        .pct_hardware-tableList-t-icpc {\n            padding: 0px !important\n        }\n\n        .pct_hardware-tableList {\n            width: 100%;\n            row-gap: 15px;\n            column-gap: 15px;\n        }\n\n        .pct_hardware-tableList .pct_st-tbc .pct_tb .pct_td {\n            height: 50px;\n        }\n    }\n</style>\n<div class=\"pct_t-icpc pct_padding-in-mobile .pct_hardware-tableList pct_hardware-tableList-t-icpc\">\n<h2 class=\"pct_t\" style=\"margin-top: 30px; font-size: 24px;\">Basic Information</h2>\n<div class=\"pct_icpc pct_grad-2-pc pct_grad-1-mobile pct_hardware-tableList\"><!-- 左列 -->\n<div class=\"pct_ic-p\">\n<div class=\"pct pct_mc\">\n<div class=\"pct_st-tbc\" style=\"padding: 0;\">\n<div class=\"pct_tbc\">\n<table class=\"pct_tb\" style=\"width: 45%; margin-top: 0; font-weight: bold;\">\n<tbody><!-- 模块开头-->\n<tr class=\"pct_tr\">\n<td class=\"pct_td\" style=\"background-color: #c7c7c7; width: 45%; text-align: center;\">Quantity</td>\n<td class=\"pct_td\">1PCS</td>\n</tr>\n<tr class=\"pct_tr\">\n<td class=\"pct_td\" style=\"background-color: #c7c7c7; width: 45%; text-align: center;\">Color</td>\n<td class=\"pct_td\">Black</td>\n</tr>\n</tbody>\n</table>\n</div>\n</div>\n</div>\n</div>\n<!-- 右列 -->\n<div class=\"pct_ic-p\">\n<div class=\"pct_ic\">\n<div class=\"pct pct_mc\">\n<div class=\"pct_st-tbc\" style=\"padding: 0;\">\n<div class=\"pct_tbc\">\n<table class=\"pct_tb\" style=\"width: 45%; margin-top: 0; font-weight: bold;\">\n<tbody><!-- 模块开头-->\n<tr class=\"pct_tr\" style=\"height: 19px;\">\n<td class=\"pct_td\" style=\"background-color: #c7c7c7; width: 45%; text-align: center;\">Material</td>\n<td class=\"pct_td\" style=\"height: 19px;\">Chromoly Steel</td>\n</tr>\n<tr class=\"pct_tr\" style=\"height: 19px;\">\n<td class=\"pct_td\" style=\"background-color: #c7c7c7; width: 45%; text-align: center;\">Weight</td>\n<td class=\"pct_td\" style=\"height: 19px;\">92.5g</td>\n</tr>\n</tbody>\n</table>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n<h2 class=\"pct_t\" style=\"margin-top: 40px; margin-bottom: 20px; font-size: 24px;\">Product Feature</h2>\n<ul>\n<li class=\"pct_p\" style=\"text-align: left;\"><strong>High-Strength Chromoly Steel:</strong> Durable and bend-resistant construction built for challenging terrains.</li>\n<li class=\"pct_p\" style=\"text-align: left;\"><strong>Universal Tool-Free Installation: </strong>Seamlessly fits 3D-printed and traditional saddles with a secure clamping system.</li>\n<li class=\"pct_p\" style=\"text-align: left;\"><strong>All-Weather Corrosion Defense:</strong> Electroplated coating resists rain, sweat, and abrasion for urban or off-road use.</li>\n</ul>\n</div>\n</div>\n</div>",
  "description_text": "This bike saddle rail is specifically designed for 3D-printed saddles, crafted from high-strength Chromoly Steel with a durable rust-resistant coating that withstands rainy rides. Its streamlined design enables tool-free installation, balancing structural integrity and practicality to meet daily commuting and casual cycling needs effortlessly.\n\nHigh-Strength Chromoly Steel: Durable and bend-resistant construction built for challenging terrains.\n\nUniversal Tool-Free Installation: Seamlessly fits 3D-printed and traditional saddles with a secure clamping system.\n\nAll-Weather Corrosion Defense: Electroplated coating resists rain, sweat, and abrasion for urban or off-road use.",
