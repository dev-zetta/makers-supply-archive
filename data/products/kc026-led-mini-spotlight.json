  "description_blocks": [
    {
      "kind": "heading",
      "text": "Introduction"
    },
    {
      "kind": "paragraph",
      "text": "The LED Mini Spotlight is a professional-grade lighting solution designed to perfectly showcase your 3D printed masterpieces with precision and clarity. Designed to bring museum-quality illumination to your desktop, it is the ideal choice for highlighting intricate details in model display cabinets, protective cases, and custom DIY Maker projects. Whether you are showcasing a complex architectural print or a detailed figure, this spotlight provides the perfect focused ambiance."
    },
    {
      "kind": "heading",
      "text": "Product Feature"
    },
    {
      "kind": "bullet",
      "text": "Precision 25° Beam Angle: Equipped with a high-quality optical lens that provides a concentrated 25° beam, ensuring your models are illuminated with precision and zero light leakage."
    },
    {
      "kind": "bullet",
      "text": "Premium Aluminum Build: Crafted with a sleek black aluminum alloy housing, offering superior durability and excellent heat dissipation for long-term use."
    },
    {
      "kind": "bullet",
      "text": "Integrated Control: Features an inline switch on a 1.5-meter cable, allowing for easy operation without disconnecting the USB power source."
    },
    {
      "kind": "heading",
      "text": "Considerations"
    },
    {
      "kind": "bullet",
      "text": "Power Supply: Ensure use with a standard DC 5V power adapter or USB port. Excessive voltage may damage the internal circuitry."
    },
    {
      "kind": "bullet",
      "text": "Indoor Use Only: This product is not waterproof; please use it in a dry, indoor environment."
    },
    {
      "kind": "bullet",
      "text": "Installation: When mounting in enclosed display cases, ensure there is adequate ventilation to assist with the aluminum housing's natural heat dissipation."
    }
  ],
  "description_html": "<div class=\"pct pct_mc\">\n<div class=\"pct_ic\">\n<div class=\"pct_t-p\">\n<div style=\"width: 100%; background-color: #ffffff; box-sizing: border-box;\">\n<h2 class=\"pct_t\" style=\"margin-top: 20px; font-size: 24px; text-align: center;\">Documentation</h2>\n<style>\n    .doc-block {\n      max-width: 1920px;\n      margin: 0 auto;\n    }\n\n    .doc-item {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding: 20px 0;\n      border-bottom: 1px solid #e5e7eb;\n    }\n\n    .doc-item:last-child {\n      border-bottom: none;\n    }\n\n    .doc-info {\n      display: flex;\n      align-items: center;\n      gap: 16px;\n    }\n\n    .icon-img {\n      width: 40px;\n      height: 40px;\n      object-fit: contain;\n      border-radius: 4px;\nalign-self: flex-start;\n    }\n\n    .text {\n      display: flex;\n      flex-direction: column;\n    }\n\n    .title {\n      font-weight: bold;\n      color: #1f2937;\n      font-size: 18px;\n      text-align: left;\n    }\n\n    .desc {\n      font-size: 14px;\n      color: #6b7280;\n    }\n\n    .download-btn {\n      background-color: #00AE42 !important;\n      color: white !important;\n      text-decoration: none !important;\n      padding: 8px 20px;\n      border-radius: 6px;\n      font-weight: bold;\n      font-size: 14px;\n      white-space: nowrap;\n      transition: background-color 0.2s ease;\n    }\n\n    .download-btn:hover {\n      background-color: #00913A;\n    }\n\n    @media (max-width: 768px) {\n      .doc-item {\n        flex-direction: column;\n        align-items: flex-start;\n        gap: 12px;\n      }\n\n      .download-btn {\n        align-self: flex-start;\n      }\n    }\n  </style>\n<!--Solid Model 模型压缩包-->\n<div class=\"doc-item\">\n<div class=\"doc-info\"><img alt=\"3D Model\" class=\"icon-img product-desc-lazy-media product-desc-lazy-media--image bg-bbl-white animate-pulse max-h-[400px]\" data-lazy=\"false\" data-src=\"https://store.bblcdn.com/s1/default/c09f0bcff3184a679d3beb705f2ddd6f/Download.png\" src=\"data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjQiIGhlaWdodD0iMjQiIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj4KPHJlY3Qgd2lkdGg9IjI0IiBoZWlnaHQ9IjI0IiBmaWxsPSIjRkZGRkZGIi8+Cjwvc3ZnPgo=\"/>\n<div class=\"text\">\n<div class=\"title\">Solid Model</div>\n<div class=\"desc\">3D Files with Structure and Dimensions.</div>\n</div>\n</div>\n<a class=\"download-btn\" href=\"https://store.bblcdn.com/s1/default/0ab860f8f8f64393a0b7c6312fded84b/LED_Mini_Spotlight_model_KC026.zip\" rel=\"noopener\" target=\"_blank\">Download</a></div>\n</div>\n</div>\n</div>\n</div>\n<div class=\"pct pct_mc\">\n<div class=\"pct_st-tbc\">\n<div class=\"pct_t-p\">\n<h2 style=\"margin-top: 20px; margin-bottom: 20px; font-size: 24px; text-align: Center;\">Introduction</h2>\n<p style=\"text-align: left; font-size: 16px;\"><strong>The LED Mini Spotlight</strong> is a professional-grade lighting solution designed to perfectly showcase your 3D printed masterpieces with precision and clarity. Designed to bring museum-quality illumination to your desktop, it is the ideal choice for highlighting intricate details in model display cabinets, protective cases, and custom DIY Maker projects. Whether you are showcasing a complex architectural print or a detailed figure, this spotlight provides the perfect focused ambiance.</p>\n</div>\n</div>\n</div>\n<div class=\"pct pct_mc\">\n<div class=\"pct_ic\">\n<div class=\"pct_t-p\">\n<h2 class=\"pct_t\" style=\"margin-top: 20px; margin-bottom: 20px; font-size: 24px; text-align: center;\">Product Feature</h2>\n<ul>\n<li style=\"text-align: left; font-size: 16px;\">Precision 25° Beam Angle: Equipped with a high-quality optical lens that provides a concentrated 25° beam, ensuring your models are illuminated with precision and zero light leakage.</li>\n<li style=\"text-align: left; font-size: 16px;\">Premium Aluminum Build: Crafted with a sleek black aluminum alloy housing, offering superior durability and excellent heat dissipation for long-term use.</li>\n<li style=\"text-align: left; font-size: 16px;\">Integrated Control: Features an inline switch on a 1.5-meter cable, allowing for easy operation without disconnecting the USB power source.</li>\n</ul>\n</div>\n</div>\n</div>\n<div class=\"pct pct_mc\">\n<div class=\"pct_st-tbc\">\n<div class=\"pct_t-p\">\n<h2 class=\"pct_t\" style=\"margin-top: 20px; font-size: 24px; text-align: center;\">Product Specifications</h2>\n<!--图片展示-->\n<div class=\"pct_ic\"><img class=\"product-desc-lazy-media product-desc-lazy-media--image bg-bbl-white animate-pulse aspect-video max-h-[400px]\" data-lazy=\"false\" data-src=\"https://store.bblcdn.com/s1/default/19c4413dd1594623a6cfb3aaf863b020/B-KC020.png\" height=\"1160\" src=\"data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjQiIGhlaWdodD0iMjQiIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj4KPHJlY3Qgd2lkdGg9IjI0IiBoZWlnaHQ9IjI0IiBmaWxsPSIjRkZGRkZGIi8+Cjwvc3ZnPgo=\" width=\"3430\"/></div>\n<style>\n    .pct_hardware-tableList-t-icpc {\n        padding: '0 20px'\n    }\n\n    .pct_hardware-tableList {\n        width: 100%;\n        row-gap: 15px !important;\n        column-gap: 15px !important;\n    }\n\n    .pct_hardware-tableList .pct_ic-p {\n        overflow: hidden;\n    }\n\n    .pct_hardware-tableList .pct_st-tbc .pct_tb .pct_td {\n        border-color: #ADADAD;\n    }\n\n    @media (min-width: 640px) {\n        .pct_hardware-tableList-t-icpc {\n            padding: 0px !important\n        }\n\n        .pct_hardware-tableList {\n            width: 100%;\n            row-gap: 15px;\n            column-gap: 15px;\n        }\n\n        .pct_hardware-tableList .pct_st-tbc .pct_tb .pct_td {\n            height: 50px;\n        }\n    }\n</style>\n<!--基础信息补充模块-->\n<div class=\"pct pct_mc\">\n<div class=\"pct_st-tbc\">\n<div class=\"pct_t-p\">\n<div class=\"pct_padding-in-mobile\">\n<div clas