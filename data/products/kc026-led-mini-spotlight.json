r-color: #adadad; text-align: center; height: 15px; padding: 10px !important;\">KC027</td>\n<td class=\"pct_td\" style=\"border-color: #adadad; text-align: center; height: 15px; padding: 10px !important;\">39</td>\n<td class=\"pct_td\" style=\"border-color: #adadad; text-align: center; height: 15px; padding: 10px !important;\">36</td>\n<td class=\"pct_td\" style=\"border-color: #adadad; text-align: center; height: 15px; padding: 10px !important;\">45</td>\n<td class=\"pct_td\" style=\"border-color: #adadad; text-align: center; height: 15px; padding: 10px !important;\">714</td>\n</tr>\n</tbody>\n</table>\n</div>\n</div>\n</div>\n</div>\n</div>\n<div class=\"pct pct_mc\">\n<div class=\"pct_t-icpc\" style=\"padding: 0;\">\n<div class=\"pct_icpc pct_grad-2-pc pct_grad-1-mobile pct_hardware-tableList\"><!--左列表-->\n<div class=\"pct_ic-p\">\n<div class=\"pct pct_mc\">\n<div class=\"pct_st-tbc\" style=\"padding: 0;\">\n<div class=\"pct_tbc\">\n<table class=\"pct_tb\" style=\"width: 45%; margin-top: 0; font-weight: bold;\">\n<tbody>\n<tr class=\"pct_tr\" style=\"height: 19px;\"><!--行模块 增加行数复制整个<tr></tr>部分即可-->\n<td class=\"pct_td\" style=\"background-color: #c7c7c7; width: 45%; text-align: center;\">Material</td>\n<td class=\"pct_td\" style=\"height: 19px;\">Black Aluminum Alloy</td>\n</tr>\n<tr class=\"pct_tr\" style=\"height: 19px;\"><!--行模块 增加行数复制整个<tr></tr>部分即可-->\n<td class=\"pct_td\" style=\"background-color: #c7c7c7; width: 45%; text-align: center;\">Interface</td>\n<td class=\"pct_td\" style=\"height: 19px;\">USB Type-A with Switch</td>\n</tr>\n<tr class=\"pct_tr\" style=\"height: 19px;\"><!--行模块 增加行数复制整个<tr></tr>部分即可-->\n<td class=\"pct_td\" style=\"background-color: #c7c7c7; width: 45%; text-align: center;\">Input Voltage</td>\n<td class=\"pct_td\" style=\"height: 19px;\">DC 5V</td>\n</tr>\n<tr class=\"pct_tr\" style=\"height: 19px;\"><!--行模块 增加行数复制整个<tr></tr>部分即可-->\n<td class=\"pct_td\" style=\"background-color: #c7c7c7; width: 45%; text-align: center;\">Dimensions</td>\n<td class=\"pct_td\" style=\"height: 19px;\">Height: 40.5 mm; Base: Ø30 mm</td>\n</tr>\n</tbody>\n</table>\n</div>\n</div>\n</div>\n</div>\n<!-- 右列表-->\n<div class=\"pct_ic-p\">\n<div class=\"pct_ic\">\n<div class=\"pct pct_mc\">\n<div class=\"pct_st-tbc\" style=\"padding: 0;\">\n<div class=\"pct_tbc\">\n<table class=\"pct_tb\" style=\"width: 45%; margin-top: 0; font-weight: bold;\">\n<tbody>\n<tr class=\"pct_tr\" style=\"height: 19px;\"><!--行模块 增加行数复制整个<tr></tr>部分即可-->\n<td class=\"pct_td\" style=\"background-color: #c7c7c7; width: 45%; text-align: center;\">Power Consumption</td>\n<td class=\"pct_td\" style=\"height: 19px;\">0.5W</td>\n</tr>\n<tr class=\"pct_tr\" style=\"height: 19px;\"><!--行模块 增加行数复制整个<tr></tr>部分即可-->\n<td class=\"pct_td\" style=\"background-color: #c7c7c7; width: 45%; text-align: center;\">Light Strip Current</td>\n<td class=\"pct_td\" style=\"height: 19px;\">\n<p>KC026 0.1 A; KC027 0.2 A</p>\n</td>\n</tr>\n<tr class=\"pct_tr\" style=\"height: 19px;\"><!--行模块 增加行数复制整个<tr></tr>部分即可-->\n<td class=\"pct_td\" style=\"background-color: #c7c7c7; width: 45%; text-align: center;\">Color Temperature (CCT)</td>\n<td class=\"pct_td\" style=\"height: 19px;\">3000K-3200K</td>\n</tr>\n<tr class=\"pct_tr\" style=\"height: 19px;\"><!--行模块 增加行数复制整个<tr></tr>部分即可-->\n<td class=\"pct_td\" style=\"background-color: #c7c7c7; width: 45%; text-align: center;\">Circuit Configuration</td>\n<td class=\"pct_td\" style=\"height: 19px;\">1pcs Resistor</td>\n</tr>\n</tbody>\n</table>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n<div class=\"pct pct_mc\">\n<div class=\"pct_ic\">\n<div class=\"pct_t-p\">\n<h2 class=\"pct_t\" style=\"margin-top: 20px; margin-bottom: 20px; font-size: 24px; text-align: center;\"><img alt=\"\" class=\"product-desc-lazy-media product-desc-lazy-media--image bg-bbl-white animate-pulse aspect-video max-h-[400px]\" data-lazy=\"false\" data-src=\"https://store.bblcdn.com/s1/default/fde769a097db448e83c11a0409b5daf7/remote_control_instruction.jpg\" height=\"1200\" src=\"data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjQiIGhlaWdodD0iMjQiIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj4KPHJlY3Qgd2lkdGg9IjI0IiBoZWlnaHQ9IjI0IiBmaWxsPSIjRkZGRkZGIi8+Cjwvc3ZnPgo=\" width=\"3000\"/></h2>\n</div>\n</div>\n</div>\n<div class=\"pct pct_mc\">\n<div class=\"pct_ic\">\n<div class=\"pct_t-p\">\n<h2 class=\"pct_t\" style=\"margin-top: 20px; margin-bottom: 20px; font-size: 24px; text-align: center;\">Considerations</h2>\n<ul>\n<li style=\"text-align: left; font-size: 16px;\">Power Supply: Ensure use with a standard DC 5V power adapter or USB port. Excessive voltage may damage the internal circuitry.</li>\n<li style=\"text-align: left; font-size: 16px;\">Indoor Use Only: This product is not waterproof; please use it in a dry, indoor environment.</li>\n<li style=\"text-align: left; font-size: 16px;\">Installation: When mounting in enclosed display cases, ensure there is adequate ventilation to assist with the aluminum housing's natural heat dissipation.</li>\n</ul>\n</div>\n</div>\n</div>",
  "description_text": "The LED Mini Spotlight is a professional-grade lighting solution designed to perfectly showcase your 3D printed masterpieces with precision and clarity. Designed to bring museum-quality illumination to your desktop, it is the ideal choice for highlighting intricate details in model display cabinets, protective cases, and custom DIY Maker projects. Whether you are showcasing a complex architectural print or a detailed figure, this spotlight provides the perfect focused ambiance.\n\nPrecision 25° Beam Angle: Equipped with a high-quality optical lens that provides a concentrated 25° beam, ensuring your models are illuminated with precision and zero light leakage.\n\nPremium Aluminum Build: Crafted with a sleek black aluminum alloy housing, offering superior durability and excellent heat dissipation for long-term use.\n\nIntegrated Control: Features an inline switch on a 1.5-meter cable, allowing for easy operation without disconnecting the USB power source.\n\nPower Supply: Ensure use with a standard DC 5V power adapter or USB port. Excessive voltage may damage the internal circuitry.\n\nIndoor Use Only: This product is not waterproof; please use it in a dry, indoor environment.\n\nInstallation: When mounting in enclosed display cases, ensure there is adequate ventilation to assist with the aluminum housing's natural heat dissipation.",
