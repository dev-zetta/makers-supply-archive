  "description_html": "<div class=\"pct pct_mc\">\n<h2 class=\"pct_st\"><br/></h2>\n<h2 class=\"pct_st\"><br/></h2>\n<h2 class=\"pct_t\">Documentation</h2>\n<h2 class=\"pct_st\"><br/></h2>\n<p class=\"pct_padding-in-mobile pct_downloadContent\" style=\"text-align: center; gap: 40px; display: flex; justify-content: center;\"><a href=\"https://store.bblcdn.com/s7/default/907ab9fec39740728e11af86b98283d6/B-AA225_PDF.pdf\" rel=\"noopener\" style=\"color: #333333; font-weight: 600; display: flex; justify-content: center; align-items: center; gap: 20px;\" target=\"_blank\"> <img alt=\"2D\" class=\"download_svg product-desc-lazy-media product-desc-lazy-media--image bg-bbl-white animate-pulse max-h-[400px]\" data-lazy=\"false\" data-src=\"https://store.bblcdn.com/37c1891b8b214de6a02847a0c35551da.svg\" src=\"data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjQiIGhlaWdodD0iMjQiIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj4KPHJlY3Qgd2lkdGg9IjI0IiBoZWlnaHQ9IjI0IiBmaWxsPSIjRkZGRkZGIi8+Cjwvc3ZnPgo=\"/> Specification </a> <a href=\"https://store.bblcdn.com/s7/default/c165e43994bd4e2ab1850db9ca228df5/M6x35_Socket_Head_Cap_Machine_Screw-B-AA225_Model.zip\" rel=\"noopener\" style=\"color: #333333; font-weight: 600; display: flex; justify-content: center; align-items: center; gap: 20px;\" target=\"_blank\"> <img alt=\"3D\" class=\"download_svg product-desc-lazy-media product-desc-lazy-media--image bg-bbl-white animate-pulse max-h-[400px]\" data-lazy=\"false\" data-src=\"https://store.bblcdn.com/7d6f25c653014e979c9102c2c29217f1.svg\" src=\"data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjQiIGhlaWdodD0iMjQiIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj4KPHJlY3Qgd2lkdGg9IjI0IiBoZWlnaHQ9IjI0IiBmaWxsPSIjRkZGRkZGIi8+Cjwvc3ZnPgo=\"/> 3D Model </a></p>\n</div>\n<div class=\"pct pct_mc\">\n<div class=\"pct_st-tbc\">\n<h2 class=\"pct_t\"><br/></h2>\n<div class=\"pct_tbc\">\n<table class=\"pct_tb\" style=\"border-color: #ADADAD; font-weight: bold;\">\n<!-- 表头 -->\n<thead class=\"pct_th\">\n<tr>\n<td class=\"pct_td\" style=\"padding: 10px!important; background-color: #c7c7c7; color: #333333; border-color: #ADADAD; font-weight: bold;\">\n<div style=\"text-align: center;\">Product ID</div>\n</td>\n<td class=\"pct_td\" style=\"padding: 10px!important; background-color: #c7c7c7; color: #333333; border-color: #ADADAD; font-weight: bold;\">\n<div>L (mm)\n<p>Bolt Length</p>\n</div>\n</td>\n<td class=\"pct_td\" style=\"padding: 10px!important; background-color: #c7c7c7; color: #333333; border-color: #ADADAD; font-weight: bold;\">\n<div>D (mm)</div>\n<p>Head Diameter</p>\n</td>\n<td class=\"pct_td\" style=\"padding: 10px!important; background-color: #c7c7c7; color: #333333; border-color: #ADADAD; font-weight: bold;\">\n<div>H (mm)</div>\n<p>Head Thickness</p>\n</td>\n<td class=\"pct_td\" style=\"padding: 10px!important; background-color: #c7c7c7; color: #333333; border-color: #ADADAD; font-weight: bold;\">\n<div>k (mm)</div>\n<p>Hexagon Across Flats</p>\n</td>\n<td class=\"pct_td\" style=\"padding: 10px!important; background-color: #c7c7c7; color: #333333; border-color: #ADADAD; font-weight: bold;\">\n<div>t (mm)</div>\n<p>Groove Depth</p>\n</td>\n<td class=\"pct_td\" style=\"padding: 10px!important; background-color: #c7c7c7; color: #333333; border-color: #ADADAD; font-weight: bold;\">\n<div>Screwdriver Bit<br/>Size\n<div><br/></div>\n</div>\n</td>\n</tr>\n</thead>\n<tbody>\n<tr class=\"pct_tr\">\n<td class=\"pct_td\" style=\"padding: 10px!important; border-color: #ADADAD; text-align: center;\">AA225</td>\n<td class=\"pct_td\" style=\"padding: 10px!important; border-color: #ADADAD;\">35</td>\n<td class=\"pct_td\" style=\"padding: 10px!important; border-color: #ADADAD;\">10</td>\n<td class=\"pct_td\" style=\"padding: 10px!important; border-color: #ADADAD;\">6</td>\n<td class=\"pct_td\" style=\"padding: 10px!important; border-color: #ADADAD;\">5</td>\n<td class=\"pct_td\" style=\"padding: 10px!important; border-color: #ADADAD;\">3</td>\n<td class=\"pct_td\" style=\"padding: 10px!important; border-color: #ADADAD;\">H5</td>\n</tr>\n</tbody>\n</table>\n</div>\n<p style=\"text-align: center; margin-top: 30px;\">*Compliant with the requirements of GB/T 70.2-2015 standard [Equivalent standards: ISO 7380-1 - 2011, DIN EN ISO 7380 (-1) - 2011]</p>\n<p style=\"text-align: center; margin-top: 30px;\">Forgot the screw specs? <span style=\"font-size: 0.875rem;\">Just print the <strong><a href=\"https://makerworld.com/zh/models/14860#profileId-14641\" rel=\"noopener\" target=\"_blank\"><span style=\"color: #00ae42;\"><span style=\"text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;\"><u>Screw Gauge model from MakerWorld</u></span></span></a> </strong> to help with sorting.</span></p>\n</div>\n</div>\n<div class=\"pct pct_mc\">\n<div class=\"pct_t-icpc pct_padding-in-mobile .pct_hardware-tableList pct_hardware-tableList-t-icpc\">\n<h2 class=\"pct_t\"><br/></h2>\n<h2 class=\"pct_st\"><br/></h2>\n<h2 class=\"pct_t\">Basic Information</h2>\n<div class=\"pct_icpc pct_grad-2-pc pct_grad-1-mobile pct_hardware-tableList\">\n<!-- 第一条 -->\n<div class=\"pct_ic-p\">\n<!-- table布局 -->\n<div class=\"pct pct_mc\">\n<div class=\"pct_st-tbc\" style=\"padding: 0;\">\n<div class=\"pct_tbc\">\n<table class=\"pct_tb\" style=\"width: 100%; margin-top: 0; font-weight: bold;\">\n<!-- 表头 -->\n<tbody>\n<tr class=\"pct_tr\">\n<td class=\"pct_td\" style=\"background-color: #c7c7c7; width: 45%; text-align: center;\">Surface Treatment</td>\n<td class=\"pct_td\">Black zinc-nickel alloy plated</td>\n</tr>\n<tr class=\"pct_tr\">\n<td class=\"pct_td\" style=\"background-color: #c7c7c7; width: 45%; text-align: center;\">Mounting Hole Shape</td>\n<td class=\"pct_td\">Hex socket</td>\n</tr>\n<tr class=\"pct_tr\">\n<td class=\"pct_td\" style=\"background-color: #c7c7c7; width: 45%; text-align: center;\">Screw Type</td>\n<td class=\"pct_td\">Machine thread</td>\n</tr>\n</tbody>\n</table>\n</div>\n</div>\n</div>\n<!-- table布局 -->\n</div>\n<!-- 第二条 -->\n<div class=\"pct_ic-p\">\n<div class=\"pct_ic\">\n<!-- table布局 -->\n<div class=\"pct pct_mc\">\n<div class=\"pct_st-tbc\" style=\"padding: 0;\">\n<div class=\"pct_tbc\">\n<table class=\"pct_tb\" style=\"width: 100%; margin-top: 0; font-weight: bold;\">\n<!-- 表头 -->\n<tbody>\n<tr class=\"pct_tr\" style=\"height: 19px;\">\n<td class=\"pct_td\" style=\"background-color: #c7c7c7; width: 45%; text-align: center;\">Material</td>\n<td class=\"pct_td\" style=\"height: 19px;\">Carbon steel</td>\n</tr>\n<tr class=\"pct_tr\" style=\"height: 19px;\">\n<td class=\"pct_td\" style=\"background-color: #c7c7c7; width: 45%; text-align: center;\">Thread Ridge Type</td>\n<td class=\"pct_td\" style=\"height: 19px;\">Full thread</td>\n</tr>\n<tr class=\"pct_tr\" style=\"height: 19px;\">\n<td class=\"pct_td\" style=\"background-color: #c7c7c7; width: 45%; text-align: center;\">Color</td>\n<td class=\"pct_td\" style=\"height: 19px;\">Black</td>\n</tr>\n</tbody>\n</table>\n</div>\n</div>\n</div>\n<!-- table布局 -->\n</div>\n</div>\n<!-- 如需添加在此处添加 -->\n</div>\n</div>\n</div>\n<div class=\"pct pct_mc\">\n<div class=\"pct_padding-in-mobile\">\n<h2 class=\"pct_t\"><br/></h2>\n<h2 class=\"pct_st\"><br/></h2>\n<h2 class=\"pct_t\">Product Feature</h2>\n<h2 class=\"pct_st\"><br/></h2>\n<ul class=\"pct_productFeatureList\">\n<li>\n<p>Carbon Steel Socket Head Cap Machine Screws (SHCS)</p>\n</li>\n<li>\n<p>Nominal thread: M6</p>\n</li>\n<li>\n<p>Strength grade: 12.9</p>\n</li>\n<li>\n<p>Full thread series</p>\n</li>\n<li>\n<p>Type of thread: Full thread</p>\n</li>\n</ul>\n</div>\n</div>",
