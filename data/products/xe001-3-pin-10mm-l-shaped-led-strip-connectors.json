  "description_html": "<div class=\"pct pct_mc\">\n<div class=\"pct_t-icpc pct_padding-in-mobile .pct_hardware-tableList pct_hardware-tableList-t-icpc\">\n<h2 class=\"pct_t\"><br/></h2>\n<h2 class=\"pct_st\"><br/></h2>\n<h2 class=\"pct_t\">Basic Information</h2>\n<div class=\"pct_icpc pct_grad-2-pc pct_grad-1-mobile pct_hardware-tableList\">\n<!-- 第一条 -->\n<div class=\"pct_ic-p\">\n<!-- table布局 -->\n<div class=\"pct pct_mc\">\n<div class=\"pct_st-tbc\" data-mce-style=\"padding: 0;\" style=\"padding: 0;\">\n<div class=\"pct_tbc\">\n<table class=\"pct_tb\" data-mce-style=\"width: 100%; margin-top: 0; font-weight: bold;\" style=\"width: 100%; margin-top: 0; font-weight: bold;\">\n<!-- 表头 -->\n<tbody>\n<tr class=\"pct_tr\">\n<td class=\"pct_td\" data-mce-style=\"background-color: #c7c7c7; width: 45%; text-align: center;\" style=\"background-color: #c7c7c7; width: 45%; text-align: center;\">Product Type</td>\n<td class=\"pct_td\">3-pin L-shaped</td>\n</tr>\n<tr class=\"pct_tr\">\n<td class=\"pct_td\" data-mce-style=\"background-color: #c7c7c7; width: 45%; text-align: center;\" style=\"background-color: #c7c7c7; width: 45%; text-align: center;\">Size（Working LED width）</td>\n<td class=\"pct_td\">10mm</td>\n</tr>\n<tr class=\"pct_tr\">\n<td class=\"pct_td\" data-mce-style=\"background-color: #c7c7c7; width: 45%; text-align: center;\" style=\"background-color: #c7c7c7; width: 45%; text-align: center;\">Light Source Type</td>\n<td class=\"pct_td\">COB</td>\n</tr>\n</tbody>\n</table>\n</div>\n</div>\n</div>\n<!-- table布局 -->\n</div>\n<!-- 第二条 -->\n<div class=\"pct_ic-p\">\n<div class=\"pct_ic\">\n<!-- table布局 -->\n<div class=\"pct pct_mc\">\n<div class=\"pct_st-tbc\" data-mce-style=\"padding: 0;\" style=\"padding: 0;\">\n<div class=\"pct_tbc\">\n<table class=\"pct_tb\" data-mce-style=\"width: 100%; margin-top: 0; font-weight: bold;\" style=\"width: 100%; margin-top: 0; font-weight: bold;\">\n<!-- 表头 -->\n<tbody>\n<tr class=\"pct_tr\">\n<td class=\"pct_td\" data-mce-style=\"background-color: #c7c7c7; width: 45%; text-align: center;\" style=\"background-color: #c7c7c7; width: 45%; text-align: center;\">Outer Material</td>\n<td class=\"pct_td\">Plastic</td>\n</tr>\n<tr class=\"pct_tr\">\n<td class=\"pct_td\" data-mce-style=\"background-color: #c7c7c7; width: 45%; text-align: center;\" style=\"background-color: #c7c7c7; width: 45%; text-align: center;\">Contact Material</td>\n<td class=\"pct_td\">Metal</td>\n</tr>\n<tr class=\"pct_tr\">\n<td class=\"pct_td\" data-mce-style=\"background-color: #c7c7c7; width: 45%; text-align: center;\" style=\"background-color: #c7c7c7; width: 45%; text-align: center;\">Quantities</td>\n<td class=\"pct_td\">10PCS</td>\n</tr>\n</tbody>\n</table>\n</div>\n</div>\n</div>\n<!-- table布局 -->\n</div>\n</div>\n<!-- 如需添加在此处添加 -->\n</div>\n</div>\n</div>\n<div class=\"pct pct_mc\">\n<div class=\"pct pct_mc\">\n<div class=\"pct_padding-in-mobile\">\n<h2 class=\"pct_t\"><br/></h2>\n<h2 class=\"pct_st\"><br/></h2>\n<h2 class=\"pct_t\">Product Feature</h2>\n<h2 class=\"pct_st\"><br/></h2>\n<ul class=\"pct_productFeatureList\">\n<li>\n<p>These connectors Only compatible with <a href=\"https://us.store.bambulab.com/collections/led-strip-light/products/ws2812b-rgb-led-strip-light?skr=yes\"><strong><span data-mce-style=\"color: #00ae42;\" style=\"color: #00ae42;\"> 3-pin 10mm LED Light Strip </span></strong></a></p>\n</li>\n<li>\n<p>No soldering required, connector makes your DIY safer and easier</p>\n</li>\n<li>\n<p>Reduced light blockage with more transparent materials to provide better visibility</p>\n</li>\n</ul>\n</div>\n</div>\n</div>\n<div class=\"pct pct_mc\">\n<div class=\"pct_tpc-ic\">\n<div class=\"pct_t-p\">\n<h2 class=\"pct_t\">Installation Tutorial</h2>\n<p class=\"pct_p\">How to connect your COB LED strip light with this connector</p>\n</div>\n<div class=\"pct_ic\">\n<!-- 手机端图片 --> <img alt=\"2-pin 8mm L-shaped LED Strip Connectors\" class=\"pct_mi product-desc-lazy-media product-desc-lazy-media--image bg-bbl-white animate-pulse max-h-[400px]\" data-lazy=\"false\" data-mce-src=\"https://store.bblcdn.com/s7/default/61facea182e446c49b12627aaf2cf1e9/Frame_1123860832.png\" data-src=\"https://store.bblcdn.com/s7/default/61facea182e446c49b12627aaf2cf1e9/Frame_1123860832.png\" src=\"data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjQiIGhlaWdodD0iMjQiIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj4KPHJlY3Qgd2lkdGg9IjI0IiBoZWlnaHQ9IjI0IiBmaWxsPSIjRkZGRkZGIi8+Cjwvc3ZnPgo=\"/> <!-- PC端图片 --> <img alt=\"2-pin 8mm L-shaped LED Strip Connectors\" class=\"pct_i product-desc-lazy-media product-desc-lazy-media--image bg-bbl-white animate-pulse max-h-[400px]\" data-lazy=\"false\" data-mce-src=\"https://store.bblcdn.com/s7/default/61facea182e446c49b12627aaf2cf1e9/Frame_1123860832.png\" data-src=\"https://store.bblcdn.com/s7/default/61facea182e446c49b12627aaf2cf1e9/Frame_1123860832.png\" src=\"data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjQiIGhlaWdodD0iMjQiIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj4KPHJlY3Qgd2lkdGg9IjI0IiBoZWlnaHQ9IjI0IiBmaWxsPSIjRkZGRkZGIi8+Cjwvc3ZnPgo=\"/>\n</div>\n</div>\n</div>",
