  "description_blocks": [
    {
      "kind": "heading",
      "text": "Introduction"
    },
    {
      "kind": "paragraph",
      "text": "You can combine this product with a Multi-Function Core Board to form a Cyberbrick transmitter module. By pairing a Remote Control Receiver Shield with another Multi-Function Core Board, you can create a Cyberbrick receiver module. Connect joysticks and buttons to the transmitter module, and motors or servos to the receiver module, and you will have a minimal Cyberbrick remote control car project unit."
    },
    {
      "kind": "heading",
      "text": "Important Notices"
    },
    {
      "kind": "bullet",
      "text": "Wiring: Strictly follow the wire sequence to avoid damaging the board or connected components."
    },
    {
      "kind": "bullet",
      "text": "Power supply: Ensure the power supply matches the specified voltage requirements to avoid damaging the transmitter shield."
    },
    {
      "kind": "bullet",
      "text": "Choking hazard: This product contains small parts. Keep out of reach of children to avoid accidental ingestion."
    }
  ],
  "description_html": "<div class=\"pct pct_mc\">\n<div class=\"pct_st-tbc\">\n<h2 class=\"pct_t\" style=\"margin-top: 20px; margin-bottom: 20px; font-size: 24px; text-align: center;\">Introduction</h2>\n<p class=\"pct_p\" style=\"text-align: left;\">You can combine this product with a <strong>Multi-Function Core Board</strong> to form a Cyberbrick transmitter module. By pairing a <strong>Remote Control Receiver Shield</strong> with another <strong>Multi-Function Core Board</strong>, you can create a Cyberbrick receiver module. Connect joysticks and buttons to the transmitter module, and motors or servos to the receiver module, and you will have a minimal Cyberbrick remote control car project unit.</p>\n</div>\n</div>\n<div class=\"pct pct_mc\">\n<div class=\"pct_st-tbc\">\n<h2 class=\"pct_t\" style=\"margin-top: 20px; margin-bottom: 20px; font-size: 24px; text-align: center;\">Can be combined with the Official R/C Combo Kits</h2>\n<div class=\"pct pct_mc\">\n<div class=\"pct_st-tbc\">\n<h3 class=\"pct_t\" style=\"margin-top: 20px; margin-bottom: 20px; font-size: 20px; text-align: left;\"><strong>Remote Control Toys</strong></h3>\n<div class=\"pct pct_mc\">\n<div class=\"pctpct_mc\">\n<div class=\"pct_ic\">\n<p class=\"pct_p\" style=\"text-align: center;\"><img class=\"product-desc-lazy-media product-desc-lazy-media--image bg-bbl-white animate-pulse aspect-video max-h-[400px]\" data-lazy=\"false\" data-src=\"https://store.bblcdn.com/s1/default/a69f0291443d40d1bbd194b8721f3cf8/RC.png\" height=\"1050\" src=\"data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjQiIGhlaWdodD0iMjQiIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj4KPHJlY3Qgd2lkdGg9IjI0IiBoZWlnaHQ9IjI0IiBmaWxsPSIjRkZGRkZGIi8+Cjwvc3ZnPgo=\" width=\"3000\"/></p>\n</div>\n</div>\n</div>\n<!--Specification-->\n<div class=\"pct pct_mc\">\n<div class=\"pct_st-tbc\">\n<h2 class=\"pct_t\" style=\"margin-top: 20px; font-size: 24px; text-align: center;\">Product Specifications</h2>\n<div class=\"pct_tbc\"><!--Banner-->\n<p class=\"pct_p\" style=\"text-align: center;\"></p>\n<p class=\"pct_p\" style=\"text-align: center; width: 100%;\"><!---图片链接替换----><img class=\"product-desc-lazy-media product-desc-lazy-media--image bg-bbl-white animate-pulse aspect-video max-h-[400px]\" data-lazy=\"false\" data-src=\"https://store.bblcdn.com/s1/default/696378e9e7b44102b9124044fe9e206f/Transmitter.png\" src=\"data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjQiIGhlaWdodD0iMjQiIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj4KPHJlY3Qgd2lkdGg9IjI0IiBoZWlnaHQ9IjI0IiBmaWxsPSIjRkZGRkZGIi8+Cjwvc3ZnPgo=\"/></p>\n<table class=\"pct_tb\"><!-- 参数表格 -->\n<thead class=\"pct_th\">\n<tr>\n<td class=\"pct_td\" style=\"text-align: center;\">Item Number</td>\n<td class=\"pct_td\" style=\"text-align: center;\">Component</td>\n<td class=\"pct_td\" style=\"text-align: center;\">Description</td>\n</tr>\n</thead>\n<tbody>\n<tr class=\"pct_tr\"><!--红字文本替换 添加列数需要复制整个tr模块-->\n<td class=\"pct_td\" style=\"text-align: center; height: 50px; width: 20%;\">1</td>\n<td class=\"pct_td\" style=\"text-align: center; height: 50px; width: 40%;\">Power Input</td>\n<td class=\"pct_td\" style=\"text-align: center; height: 50px; width: 40%;\">XH2.54 2Pin DC power input</td>\n</tr>\n<tr class=\"pct_tr\">\n<td class=\"pct_td\" style=\"text-align: center; height: 50px; width: 20%;\">2</td>\n<td class=\"pct_td\" style=\"text-align: center; height: 50px; width: 40%;\">ADC Input Port</td>\n<td class=\"pct_td\" style=\"text-align: center; height: 50px; width: 40%;\">Connecting ADC modules such as joystick</td>\n</tr>\n<tr class=\"pct_tr\">\n<td class=\"pct_td\" style=\"text-align: center; height: 50px; width: 20%;\">3</td>\n<td class=\"pct_td\" style=\"text-align: center; height: 50px; width: 40%;\">Digital Input Port</td>\n<td class=\"pct_td\" style=\"text-align: center; height: 50px; width: 40%;\">Connecting binary-input modules such as momentary button</td>\n</tr>\n<tr class=\"pct_tr\">\n<td class=\"pct_td\" style=\"text-align: center; height: 50px; width: 20%;\">4</td>\n<td class=\"pct_td\" style=\"text-align: center; height: 50px; width: 40%;\">Core Slot</td>\n<td class=\"pct_td\" style=\"text-align: center; height: 50px; width: 40%;\">Connectable with multi-function controller core</td>\n</tr>\n<tr class=\"pct_tr\">\n<td class=\"pct_td\" style=\"text-align: center; height: 50px; width: 20%;\">5</td>\n<td class=\"pct_td\" style=\"text-align: center; height: 50px; width: 40%;\">Orientation Mark</td>\n<td class=\"pct_td\" style=\"text-align: center; height: 50px; width: 40%;\">Ensure proper installation alignmen</td>\n</tr>\n</tbody>\n</table>\n</div>\n</div>\n</div>\n<div class=\"pct pct_mc\">\n<div class=\"pct_st-tbc\">\n<div class=\"pct_tbc\">\n<div class=\"pct pct_mc\">\n<div class=\"pct_padding-in-mobile\">\n<div class=\"pct_st-p\">\n<table class=\"pct_tb\" style=\"border-color: #adadad; font-weight: bold; height: 75px; width: 111.864%;\">\n<thead class=\"pct_th\">\n<tr style=\"height: 40px;\">\n<td class=\"pct_td\" style=\"background-color: #c7c7c7; color: #333333; border-color: #adadad; font-weight: bold; text-align: center; height: 40px; width: 13.6939%; padding: 10px !important;\">\n<div>Product ID</div>\n</td>\n<td class=\"pct_td\" style=\"background-color: #c7c7c7; color: #333333; border-color: #adadad; font-weight: bold; height: 40px; width: 16.6547%; padding: 10px !important;\">\n<div>Model</div>\n</td>\n<td class=\"pct_td\" style=\"background-color: #c7c7c7; color: #333333; border-color: #adadad; font-weight: bold; height: 40px; width: 12.5836%; padding: 10px !important;\">Input Voltage</td>\n<td class=\"pct_td\" style=\"background-color: #c7c7c7; color: #333333; border-color: #adadad; font-weight: bold; height: 40px; width: 12.5836%; padding: 10px !important;\">Working Current</td>\n<td class=\"pct_td\" style=\"background-color: #c7c7c7; color: #333333; border-color: #adadad; font-weight: bold; height: 40px; width: