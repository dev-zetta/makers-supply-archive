  "description_blocks": [
    {
      "kind": "heading",
      "text": "Introduction"
    },
    {
      "kind": "paragraph",
      "text": "Peripheral connection cable - XH2.54-2PIN is a standard interface used for connecting various electronic modules and expansion boards. It is compatible with 2.54mm pitch pin headers or sockets, making it convenient for quickly building circuit systems."
    },
    {
      "kind": "heading",
      "text": "Consideration"
    },
    {
      "kind": "bullet",
      "text": "Please hold the connector when plugging and unplugging, and do not forcefully twist the connectors to avoid wires loosening or detaching."
    }
  ],
