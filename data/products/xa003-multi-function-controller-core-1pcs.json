  "description_blocks": [
    {
      "kind": "heading",
      "text": "Introduction"
    },
    {
      "kind": "paragraph",
      "text": "You can pair this product with either the Remote Control Receiver Shield or the Remote Control Transmitter Shield to serve as the receiver or transmitter component in RC projects. Additionally, by combining it with the Time-lapse Expansion Board, you can create a time-lapse photography module for Bambu Lab 3D printers."
    },
    {
      "kind": "heading",
      "text": "Time-lapse Photography"
    },
    {
      "kind": "paragraph",
      "text": "Explore the Product Wiki & Documentation Need in-depth assembly guides, troubleshooting, or technical details for this product? Visit our official Wiki to discover comprehensive resources and answers to all your questions. Visit Wiki"
    },
    {
      "kind": "paragraph",
      "text": "Explore the Product Wiki & Documentation Need in-depth assembly guides, troubleshooting, or technical details for this product? Visit our official Wiki to discover comprehensive resources and answers to all your questions."
    },
    {
      "kind": "paragraph",
      "text": "Explore the Product Wiki & Documentation"
    },
    {
      "kind": "paragraph",
      "text": "Need in-depth assembly guides, troubleshooting, or technical details for this product? Visit our official Wiki to discover comprehensive resources and answers to all your questions."
    },
    {
      "kind": "paragraph",
      "text": "Visit Wiki"
    },
    {
      "kind": "heading",
      "text": "Important Notices"
    },
    {
      "kind": "bullet",
      "text": "For security and stability, the CyberBrick Multi-Function Core Board only supports firmware updates through official tools. Flashing with third-party tools is not supported and may cause irreversible damage, which is not covered by warranty. Please use only official tools for any firmware operations. Thank you for your understanding!"
    },
    {
      "kind": "bullet",
      "text": "If you have purchased the time-lapse photography shield and are using it together with the Cyberbrick core board, please refer to the wiki to flash the time-lapse photography firmware."
    },
    {
      "kind": "bullet",
      "text": "The company is not responsible for any device damage, malfunction, fire, or other losses resulting from failure to comply with the above requirements. Please strictly follow the safety instructions for this product."
    }
  ],
  "description_html": "<div class=\"pct pct_mc\">\n<div class=\"pct_st-tbc\">\n<h2 class=\"pct_t\" style=\"margin-top: 20px; margin-bottom: 20px; font-size: 24px; text-align: center;\">Introduction</h2>\n<p class=\"pct_p\" style=\"text-align: left;\">You can pair this product with either the Remote Control Receiver Shield or the Remote Control Transmitter Shield to serve as the receiver or transmitter component in RC projects. Additionally, by combining it with the Time-lapse Expansion Board, you can create a time-lapse photography module for Bambu Lab 3D printers.</p>\n</div>\n</div>\n<div class=\"pct pct_mc\">\n<div class=\"pct_st-tbc\">\n<h2 class=\"pct_t\" style=\"margin-top: 20px; margin-bottom: 20px; font-size: 24px; text-align: center;\">Can be combined with the Official R/C Combo Kits</h2>\n<div class=\"pct pct_mc\">\n<div class=\"pct_st-tbc\">\n<h3 class=\"pct_t\" style=\"margin-top: 20px; margin-bottom: 20px; font-size: 20px; text-align: left;\"><strong>Remote Control Toys</strong></h3>\n<div class=\"pct pct_mc\">\n<div class=\"pctpct_mc\">\n<div class=\"pct_ic\">\n<p class=\"pct_p\" style=\"text-align: center;\"><img class=\"product-desc-lazy-media product-desc-lazy-media--image bg-bbl-white animate-pulse aspect-video max-h-[400px]\" data-lazy=\"false\" data-src=\"https://store.bblcdn.com/s1/default/a69f0291443d40d1bbd194b8721f3cf8/RC.png\" height=\"1050\" src=\"data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjQiIGhlaWdodD0iMjQiIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj4KPHJlY3Qgd2lkdGg9IjI0IiBoZWlnaHQ9IjI0IiBmaWxsPSIjRkZGRkZGIi8+Cjwvc3ZnPgo=\" width=\"3000\"/></p>\n</div>\n</div>\n</div>\n<div class=\"pct_t-p\"><!-- MW合集 -->\n<p class=\"pct_p\" style=\"text-align: center;\"><a href=\"https://makerworld.com/en/collections/5465389-cyberbrick-compatible-models\" rel=\"noopener\" target=\"_blank\"><img class=\"product-desc-lazy-media product-desc-lazy-media--image bg-bbl-white animate-pulse aspect-video max-h-[400px]\" data-lazy=\"false\" data-src=\"https://store.bblcdn.com/s1/default/b867fd41e76d4f90b077b0a5eb1a6afb/Colection_Banner.png\" src=\"data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjQiIGhlaWdodD0iMjQiIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj4KPHJlY3Qgd2lkdGg9IjI0IiBoZWlnaHQ9IjI0IiBmaWxsPSIjRkZGRkZGIi8+Cjwvc3ZnPgo=\"/></a></p>\n</div>\n<div class=\"pct pct_mc\">\n<div class=\"pct_st-tbc\">\n<h3 class=\"pct_t\" style=\"margin-top: 20px; margin-bottom: 20px; font-size: 20px; text-align: left;\"><strong>Time-lapse Photography</strong></h3>\n<div class=\"pct pct_mc\">\n<div class=\"pctpct_mc\">\n<div class=\"pct_ic\">\n<p style=\"margin-top: 30px;\"><video autoplay=\"autoplay\" class=\"product-desc-lazy-media product-desc-lazy-media--video bg-bbl-white animate-pulse aspect-video max-h-[400px]\" controls=\"controls\" data-lazy=\"false\" data-mce-src=\"https://store.bblcdn.com/s1/default/1a0683e737144db8bf7f4506197a27a7/TLK_V9.mp4\" data-mce-style=\"width: 100%;\" data-src=\"https://store.bblcdn.com/s1/default/1a0683e737144db8bf7f4506197a27a7/TLK_V9.mp4\" height=\"150\" loop=\"loop\" muted=\"\" playsinline=\"\" poster=\"data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjQiIGhlaWdodD0iMjQiIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj4KPHJlY3Qgd2lkdGg9IjI0IiBoZWlnaHQ9IjI0IiBmaWxsPSIjRkZGRkZGIi8+Cjwvc3ZnPgo=\" style=\"width: 100%;\" width=\"300\"></video></p>\n</div>\n</div>\n</div>\n<style><!-- Wiki指引 -->\n    body {\n      background: #f6f8fa;\n      margin: 0;\n      font-family: sans-serif;\n      display: flex;\n      justify-content: center;\n    }\n\n    .wiki-wide-card {\n      display: flex;\n      align-items: center;\n      background: #ffffff; /* ✅ 设置为正白背景 */\n      border-radius: 12px;\n      padding: 24px 32px;\n      width: 960px;\n      max-width: 100%;\n      margin: 40px auto;\n      gap: 20px;\n      box-shadow: none; /* ✅ 无阴影 */\n    }\n\n    .wiki-wide-content {\n      flex: