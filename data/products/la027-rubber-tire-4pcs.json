  "description_blocks": [
    {
      "kind": "heading",
      "text": "Introduction"
    },
    {
      "kind": "paragraph",
      "text": "These 33.7mm rubber tires feature a durable, realistic design and a stylish black finish, perfect for various toy models and RC cars. Their compact size allows for precise control, and easy installation makes them an ideal choice for upgrades or repairs."
    },
    {
      "kind": "heading",
      "text": "Important Notices"
    },
    {
      "kind": "bullet",
      "text": "Chemical exposure: Keep the tires away from corrosive chemicals (such as solvents or strong acids) to prevent material degradation."
    },
    {
      "kind": "bullet",
      "text": "Choking hazard: This product contains small parts. Keep out of reach of children to avoid accidental ingestion."
    }
  ],
