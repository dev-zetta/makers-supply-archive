  "description_blocks": [
    {
      "kind": "heading",
      "text": "Introduction"
    },
    {
      "kind": "paragraph",
      "text": "Servo extension cable was used to connect servos to controllers, ideal for extending or distributing servo connections to RC model devices. Maker's Supply offers both straight and Y-type configurations to meet different installation and control needs."
    },
    {
      "kind": "heading",
      "text": "Consideration"
    },
    {
      "kind": "bullet",
      "text": "Please hold the connector when plugging and unplugging, and do not forcefully twist the connectors to avoid wires loosening or detaching."
    }
  ],
  "description_html": "<div class=\"pct pct_mc\">\n<div class=\"pct_tpc-ic\">\n<div class=\"pct_t-p\">\n<h2 class=\"pct_t\" style=\"margin-top: 30px; margin-bottom: 20px; text-align: center; font-size: 24px;\">Documentation</h2>\n<p class=\"pct_padding-in-mobile pct_downloadContent\" style=\"text-align: center; gap: 40px; display: flex; justify-content: center;\"><!--规格参数--><a href=\"https://store.bblcdn.com/s1/default/d099bf67d4b1477a8fadc3731be9d3a3/XC011-XC012_Specification.pdf\" rel=\"noopener\" style=\"color: #333333; font-weight: 600; display: flex; justify-content: center; align-items: center; gap: 20px;\" target=\"_blank\"> <img alt=\"2D\" class=\"download_svg product-desc-lazy-media product-desc-lazy-media--image bg-bbl-white animate-pulse max-h-[400px]\" data-lazy=\"false\" data-src=\"https://cdn.shopify.com/s/files/1/0611/4036/9460/files/2d.svg?v=1715161943\" src=\"data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjQiIGhlaWdodD0iMjQiIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj4KPHJlY3Qgd2lkdGg9IjI0IiBoZWlnaHQ9IjI0IiBmaWxsPSIjRkZGRkZGIi8+Cjwvc3ZnPgo=\"/> <span>Specifications</span> </a></p>\n</div>\n</div>\n</div>\n<div class=\"pct pct_mc\">\n<div class=\"pct_ic\">\n<div class=\"pct pct_mc\">\n<div class=\"pct_tpc-ic\">\n<div class=\"pct_t-p\">\n<p class=\"pct_p\" style=\"text-align: center;\"><span style=\"color: #95a5a6;\"><em>*Specifications: Essential electrical and physical parameters required for proper operation.</em></span></p>\n</div>\n</div>\n<!--Introduction-->\n<h2 class=\"pct_t\" style=\"margin-top: 20px; font-size: 24px; text-align: left;\">Introduction</h2>\n<!---红字文本替换---->\n<p class=\"pct_p\" style=\"text-align: left;\">Servo extension cable was used to connect servos to controllers, ideal for extending or distributing servo connections to RC model devices. Maker's Supply offers both straight and Y-type configurations to meet different installation and control needs.</p>\n<!--Specification-->\n<div cl